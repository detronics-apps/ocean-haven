[ext_resource type="Texture2D" path="res://assets/buildings/source/net_return_point.svg" id="2_t"]

[resource]
script = ExtResource("1_s")
short_name = "Net Point"
explains = 1
id = &"net_return_point"
display_name = "Net Return Point"
description = "Fishers bring their worn-out nets and line here to be recycled, and every new net gets its boat's mark, so anything lost can be reported and fetched. No new lost nets or fishing line drift in on any island."
summary = "Old nets recycled, new ones marked: no new lost gear anywhere."
order = 8
texture = ExtResource("2_t")
terrain = PackedStringArray("sand", "grass", "rock")
cost_funding = 120
cost_items = Dictionary[StringName, int]({&"wood": 3})
max_count = 1
only_on = &"deep_sea"
needs_flag = &"gear_traced"
stops_litter = PackedStringArray("ghost_net", "fishing_line")
placement_hint = "near the dock"
fact = "Fishing nets marked with their boat can be traced, reported and recovered when they're lost, and old nylon nets can be recycled into new nylon."
