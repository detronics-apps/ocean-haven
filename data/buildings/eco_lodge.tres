[resource]
script = ExtResource("1_s")
id = &"eco_lodge"
display_name = "Mangrove Eco-Lodge"
description = "Visitors walk the boardwalks and watch the flamingos. More flamingos and a healthier coast, more visitors and funding."
order = 4
texture = ExtResource("2_t")
terrain = PackedStringArray("sand", "grass")
cost_funding = 144
cost_items = Dictionary[StringName, int]({&"wood": 4})
facility = &"funding"
visitors = 20
visitors_per_animal = 8
watches = &"american_flamingo"
watch_range = 0.0
max_count = 3
only_on = &"mangrove_coast"
placement_hint = "on the land, looking over the flats"
fact = "Mangrove boardwalks let people see these forests up close without trampling the roots or disturbing the wildlife."
