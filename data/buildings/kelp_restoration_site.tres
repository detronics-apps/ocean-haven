[resource]
script = ExtResource("1_krs")
id = &"kelp_restoration_site"
display_name = "Kelp Restoration Site"
description = "Young kelp grown on ropes under a marker buoy helps nearby beds grow back faster. It can't win against overgrazing: where urchins are too many, the kelp still declines."
order = 3
texture = ExtResource("2_krs")
size = Vector2i(1, 1)
terrain = PackedStringArray("water", "")
cost_funding = 50
cost_litter = 3
cost_items = Dictionary[StringName, int]({&"wood": 1})
max_count = 4
upkeep = 3
demolishable = true
restore_range = 140.0
only_on = &"kelp_forest"
category = &"sea"
storm_proof = true
placement_hint = "on the water by the kelp"
fact = "Kelp can be restored by growing young kelp on ropes and moving it out to bare reefs, but it only survives where grazing urchins are kept in balance."
