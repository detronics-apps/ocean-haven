[resource]
script = ExtResource("1_s")
id = &"crab_habitat"
display_name = "Crab Habitat"
description = "A protected patch of soft mud where mangrove crabs can dig their burrows. Crab burrows drain the mud and slow the silting, but too many crabs undercut the banks."
order = 2
texture = ExtResource("2_t")
size = Vector2i(1, 1)
terrain = PackedStringArray("mud")
cost_funding = 60
cost_litter = 5
cost_items = Dictionary[StringName, int]({&"wood": 2})
max_count = 5
animal_capacity = 2
hosts = &"mangrove_crab"
max_tier = 3
upgrade_funding = 60
upgrade_items = Dictionary[StringName, int]({&"wood": 2})
upkeep = 4
demolishable = true
only_on = &"mangrove_coast"
placement_hint = "on the mud"
fact = "Crabs are the gardeners of the mangrove: their burrows bring air and water into the mud, and they recycle fallen leaves."
