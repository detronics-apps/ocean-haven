[resource]
script = ExtResource("1_gjtea")
explains = 1
id = &"house"
display_name = "Ranger House"
description = "A proper ranger's home, with solar power. Replaces your tent; sleep here at night. Stores 4 of each wood and sapling, 8 at level 2 and 10 at level 3 (sand, mud and the rest go in the Exploration Ship). You can build 2 on each island."
summary = "Your home: sleep here and store wood."
order = 2
texture = ExtResource("2_22yc1")
terrain = PackedStringArray("sand", "grass", "rock", "ice")
cost_litter = 10
cost_funding = 120
replaces = &"tent"
action = &"sleep"
fact = "Solar panels let remote ranger stations run without noisy, polluting generators."
cost_items = Dictionary[StringName, int]({&"wood": 2})
storage = 4
stores = PackedStringArray("wood", "sapling", "coastal_sapling", "pine_sapling", "mangrove_propagule")
storage_per_tier = PackedInt32Array(4, 8, 10)
max_count = 2
max_tier = 3
upgrade_funding = 80
upgrade_items = Dictionary[StringName, int]({&"wood": 2})
tier_textures = Array[Texture2D]([ExtResource("2_22yc1"), ExtResource("9_h2"), ExtResource("9_h3")])
