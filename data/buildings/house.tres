[resource]
script = ExtResource("1_gjtea")
id = &"house"
display_name = "Ranger House"
description = "A proper ranger's home, with solar power. Replaces your tent; sleep here at night. Stores 4 of each (wood, sand, mud, saplings), 8 at level 2 and 10 at level 3. You can build 2 on each island."
