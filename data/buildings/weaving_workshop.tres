[ext_resource type="Texture2D" path="res://assets/buildings/source/weaving_workshop.svg" id="2_t"]

[resource]
script = ExtResource("1_s")
short_name = "Workshop"
explains = 1
id = &"weaving_workshop"
display_name = "Weaving Workshop"
description = "Local weavers make strong market baskets from nipa palm leaves, which grow among the mangroves. The fish market uses them instead of plastic bags: no new bags drift in on any island."
summary = "Woven baskets instead of plastic bags: no new bags anywhere."
order = 8
texture = ExtResource("2_t")
terrain = PackedStringArray("sand", "grass", "mud")
cost_funding = 120
cost_items = Dictionary[StringName, int]({&"wood": 3})
max_count = 1
only_on = &"mangrove_coast"
needs_flag = &"bags_traced"
stops_litter = PackedStringArray("plastic_bag")
placement_hint = "on the shore, near the market"
fact = "Nipa palms grow in mangrove swamps, and their leaves have long been woven into baskets, mats and roofs."
