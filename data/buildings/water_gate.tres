[resource]
script = ExtResource("1_s")
id = &"water_gate"
display_name = "Water Gate"
description = "A wooden gate across a channel. Open, it lets fish through and flushes silt out, but the flats drain. Closed, it holds water on the flats for the flamingos, but blocks fish and lets silt settle. Every gate on the island sets the water level together."
order = 1
texture = ExtResource("2_t")
closed_texture = ExtResource("3_t")
size = Vector2i(1, 1)
terrain = PackedStringArray("water")
cost_funding = 49
cost_items = Dictionary[StringName, int]({&"wood": 2})
max_count = 6
only_on = &"mangrove_coast"
action = &"gate"
needs_banks = true
storm_proof = true
demolishable = true
category = &"sea"
placement_hint = "across a narrow channel, with land on both sides"
fact = "People have long used gates and sluices to manage water in wetlands. Opening and closing them at the right times keeps both fish and birds fed."
