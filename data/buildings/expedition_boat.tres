[resource]
script = ExtResource("1_k7kwi")
short_name = "Ship"
id = &"expedition_boat"
display_name = "Exploration Ship"
description = "Makes this island Exploration Ready. Can be built once the island's objective is done. Moor it next to 2 dock planks, then walk up to it to upgrade the fleet with island discoveries and explore warmer or colder waters. Once the fleet has the Cargo Module (from the Deep Sea), its cargo hold stores 99 of everything (wood, saplings, sand, mud, clean water, coral fragments). One per island."
summary = "Explores to find new islands."
order = 5
texture = ExtResource("2_br52n")
size = Vector2i(2, 1)
terrain = PackedStringArray("water", "")
cost_funding = 660
one_per_island = true
requires = &"dock"
must_touch = &"dock"
must_touch_count = 2
placement_hint = "in the water, right next to 2 dock planks"
fact = "Research vessels carry rangers and scientists far out to sea to study and protect the open ocean."
cost_items = Dictionary[StringName, int]({&"wood": 5})
category = &"sea"
action = &"explore"
needs_objective = true
fleet_textures = Array[Texture2D]([ExtResource("2_br52n"), ExtResource("3_lv2"), ExtResource("3_lv3"), ExtResource("3_lv4"), ExtResource("3_lv5"), ExtResource("3_lv6")])
storm_proof = true
storage = 99
storage_needs = &"cargo_module"
stores = PackedStringArray("wood", "sapling", "coastal_sapling", "pine_sapling", "mangrove_propagule", "sand", "mud", "clean_water", "coral_fragment")
