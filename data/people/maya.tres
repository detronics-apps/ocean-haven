[gd_resource type="Resource" script_class="PersonData" format=3]

[ext_resource type="Script" path="res://scripts/people/person_data.gd" id="1_p"]
[ext_resource type="Script" path="res://scripts/people/talk_topic.gd" id="2_t"]
[ext_resource type="Script" path="res://scripts/systems/objective_goal.gd" id="3_g"]
[ext_resource type="Texture2D" path="res://assets/buildings/people/field_camp.svg" id="4_place"]

[sub_resource type="Resource" id="Topic_0"]
script = ExtResource("2_t")
id = &"hello_far"
when = PackedStringArray("first", "flag:sonar_recovered")
lines = PackedStringArray("You must be {name}, the ranger who pulled the old sonar out of that wreck! I'm Maya, a researcher.", "I came to find out why so few animals live here. It looks like you've already started answering that.")

[sub_resource type="Resource" id="Topic_1"]
script = ExtResource("2_t")
id = &"hello_station"
when = PackedStringArray("first", "built:marine_rescue_station")
lines = PackedStringArray("{name}, you built the rescue station already? Then we'll work well together. I'm Maya, a researcher.", "I came to find out why so few animals live on this island now.")

[sub_resource type="Resource" id="Topic_2"]
script = ExtResource("2_t")
id = &"hello"
when = PackedStringArray("first")
lines = PackedStringArray("Oh, hello! You must be {name}, the new ranger. I'm Maya, a researcher.", "I came to find out why so few animals live on this island now. I could use someone who knows the water.")

[sub_resource type="Resource" id="Topic_3"]
script = ExtResource("2_t")
id = &"ending"
when = PackedStringArray("flag:observatory_opened")
lines = PackedStringArray("When we started, we thought we were helping six islands.")

[sub_resource type="Resource" id="Goal_4"]
script = ExtResource("3_g")
kind = &"photos"
amount = 3
text = "Photograph 3 different kinds of animal"

[sub_resource type="Resource" id="Topic_4"]
script = ExtResource("2_t")
id = &"photos"
lines = PackedStringArray("Who do you think still lives on this island?", "> Turtles, maybe? | I'm not sure.", "Let's find out together! Could you photograph three different kinds of animal for me? Walk up slowly, so they stay calm.")
objective = SubResource("Goal_4")
thanks = PackedStringArray("Look at these, {name}! Every one of them does something for this island, even the little ones.", "Now I want to know what changed for them.")
reminder = PackedStringArray("Any luck with the photos? Walk up slowly and the animals stay calm.")

[sub_resource type="Resource" id="Goal_5"]
script = ExtResource("3_g")
kind = &"built"
target = &"marine_rescue_station"
island = &"home_island"
text = "Build the Marine Search & Rescue Station"

[sub_resource type="Resource" id="Topic_5"]
script = ExtResource("2_t")
id = &"station"
lines = PackedStringArray("How do you think we'd see what's happening out on the water?", "> From a boat? | From up high?", "Good thinking! With a search and rescue station we could send boats out to look, and to help animals in trouble. Could you build one? It's in your Build menu.")
objective = SubResource("Goal_5")
thanks = PackedStringArray("A real station! I'm moving my notes in right away.")
reminder = PackedStringArray("The Marine Search & Rescue Station is in your Build menu. I'll move my notes in as soon as it's up.")
stuck_when = PackedStringArray("flag:build_menu_opened")
stuck = PackedStringArray("You've looked in the Build menu? Building takes more than funding.", "Tom at the lighthouse has watched this island for fifty years. Ask him where to start.")

[sub_resource type="Resource" id="Goal_6"]
script = ExtResource("3_g")
kind = &"flag"
target = &"wreck_found"
text = "Find what's hidden off the coast"

[sub_resource type="Resource" id="Topic_6"]
script = ExtResource("2_t")
id = &"wreck"
lines = PackedStringArray("Look at this old chart. There's a mark off the west coast that isn't on any map today.", "What do you think it could be?", "> A rock? | Treasure!", "Let's find out! The station has a sonar: sweep that stretch of coast with it and see what echoes back.")
objective = SubResource("Goal_6")
thanks = PackedStringArray("A wreck! So that's what the old chart was marking.")
reminder = PackedStringArray("Try a Sonar Sweep at the station. A Coastal survey mission could find it too, but it can take a few tries.")

[sub_resource type="Resource" id="Goal_7"]
script = ExtResource("3_g")
kind = &"flag"
target = &"wreck_cleared"
text = "Clear the litter around the old wreck"

[sub_resource type="Resource" id="Topic_7"]
script = ExtResource("2_t")
id = &"clear"
lines = PackedStringArray("The wreck is tangled with old nets and rubbish. What do you think that does to the animals swimming past?", "> They could get caught. | Let's clean it up!", "That's what I was hoping you'd say. Could you row out and clear it?")
objective = SubResource("Goal_7")
thanks = PackedStringArray("It's clear! Fish are already hiding in it again.")
reminder = PackedStringArray("Is the wreck clear yet? You can pick up everything around it from your boat.")

[sub_resource type="Resource" id="Goal_8"]
script = ExtResource("3_g")
kind = &"flag"
target = &"sonar_recovered"
text = "Lift the wreck's old sonar unit"

[sub_resource type="Resource" id="Topic_8"]
script = ExtResource("2_t")
id = &"sonar"
lines = PackedStringArray("Now that it's clear, I saw something inside: an old sonar unit.", "I wonder if it still works? A ship with sonar could find its way to places nobody has mapped.", "Could you lift it into your boat? Sail right over the wreck.")
objective = SubResource("Goal_8")
thanks = PackedStringArray("It works! It actually works.", "With this, a ship could find new islands. Imagine what lives out there.")
reminder = PackedStringArray("Sail your boat right over the wreck to lift the old sonar.")

[sub_resource type="Resource" id="Goal_9"]
script = ExtResource("3_g")
kind = &"installed"
target = &"salvaged_sonar_core"
text = "Build an Exploration Ship and fit the sonar"

[sub_resource type="Resource" id="Topic_9"]
script = ExtResource("2_t")
id = &"ship"
lines = PackedStringArray("What do you think is out there, past our waters?", "> Other islands? | Let's go and see!", "Maybe! An Exploration Ship goes by the dock, next to two planks. Fit the sonar to it, and we'll know.")
objective = SubResource("Goal_9")
thanks = PackedStringArray("Your ship can find its way now, {name}. Wherever you go, look for the people who know those waters best.", "And take photos for me! Every island has its own story.")
reminder = PackedStringArray("Build the Exploration Ship beside two dock planks, then fit the sonar at the ship.")

[sub_resource type="Resource" id="Goal_10"]
script = ExtResource("3_g")
kind = &"flag"
target = &"foam_traced"
text = "Find out where the foam boxes come from"

[sub_resource type="Resource" id="Topic_10"]
script = ExtResource("2_t")
id = &"foam"
when = PackedStringArray("installed>=2", "picked:foam_box>=15")
lines = PackedStringArray("These white foam boxes keep breaking into tiny beads on the beach. You've picked up {picked:foam_box} of them, {name}.", "Where do you think they come from?", "> Fishing boats? | The beach?", "Let's find out. A rescue boat can follow the foam back along the coast: send Trace the foam boxes from the station.")
objective = SubResource("Goal_10")
thanks = PackedStringArray("So it's the fishing boats: one trip, and the box is thrown away.")
reminder = PackedStringArray("Send Trace the foam boxes from the rescue station, and we'll know where they come from.")
marks = &"foam_asked"

[sub_resource type="Resource" id="Goal_11"]
script = ExtResource("3_g")
kind = &"stopped"
target = &"foam_box"
text = "Stop the foam boxes at their source"

[sub_resource type="Resource" id="Topic_11"]
script = ExtResource("2_t")
id = &"boxes"
lines = PackedStringArray("What could the boats pack their fish in instead?", "> Stronger boxes? | Ask Tom!", "Tom remembers how they did it in his father's day. A Box Return Depot by the dock could do the same: it's in your Build menu.")
objective = SubResource("Goal_11")
thanks = PackedStringArray("No more foam! The same boxes go out on the boats, trip after trip.", "We didn't just clean the beach this time. We stopped it getting dirty.")
reminder = PackedStringArray("The Box Return Depot is in your Build menu: sturdy boxes that come back to be washed and used again.")

[sub_resource type="Resource" id="Goal_12"]
script = ExtResource("3_g")
kind = &"flag"
target = &"observatory_opened"
text = "Open the Global Ocean Observatory (on the Map)"

[sub_resource type="Resource" id="Topic_12"]
script = ExtResource("2_t")
id = &"observatory"
when = PackedStringArray("installed>=6", "stopped:plastic_bottle", "stopped:plastic_bag", "stopped:six_pack_rings", "stopped:foam_box", "stopped:ghost_net", "stopped:microfibres")
lines = PackedStringArray("{name}, look at this. Six islands, six discoveries, and not one of those kinds of litter still starting.", "Your ships are Ocean Research Vessels now. What do you think we've learned?", "> It's all connected? | I'm still working it out.", "Come and see. Open the Global Ocean Observatory on your Map: it watches the whole ocean.")
objective = SubResource("Goal_12")
thanks = PackedStringArray("You saw it too, didn't you? We thought we were helping six islands.", "And the world's still open, {name}. There's always more to watch.")
reminder = PackedStringArray("The Global Ocean Observatory is at the top of your Map.")

[sub_resource type="Resource" id="Topic_13"]
script = ExtResource("2_t")
id = &"guess_nest"
when = PackedStringArray("built:turtle_protection_area", "nested:green_turtle<1")
lines = PackedStringArray("Your turtle area is ready. What do you think will happen on that quiet sand?", "> A turtle will nest! | Nothing, yet.", "Let's watch and see. I'll write your guess down in your Journal.")
outcome_when = PackedStringArray("nested:green_turtle>=1")
outcome = "A turtle came ashore at night and laid her eggs in the quiet sand. The first nest on this beach in years."

[sub_resource type="Resource" id="Topic_14"]
script = ExtResource("2_t")
id = &"album"
when = PackedStringArray("installed:salvaged_sonar_core", "missing_moments>0")
lines = PackedStringArray("I'm putting together a photo record of every island's animals: not just who lives there, but what they do.", "You have {moments} of {moments_total} photo moments so far. The ones still missing are in your Journal, if you're passing by.")

[sub_resource type="Resource" id="Topic_15"]
script = ExtResource("2_t")
id = &"out_there"
when = PackedStringArray("installed:salvaged_sonar_core")
lines = PackedStringArray("What do you think is happening out there? Come back and tell me everything you find.")

[sub_resource type="Resource" id="Topic_16"]
script = ExtResource("2_t")
id = &"watch"
lines = PackedStringArray("What do you think is happening on this island? Keep watching: the animals will show you.")

[resource]
script = ExtResource("1_p")
id = &"maya"
display_name = "Dr. Maya Okafor"
short_name = "Maya"
job = "Researcher"
region = &"home_island"
role = &"objective"
spot = Vector2(144, -72)
where = "at her field camp"
moves_to = &"marine_rescue_station"
moved_where = "by the rescue station"
place_offset = Vector2(-68, 6)
skin = Color(0.55, 0.33, 0.14, 1)
hair = 3
hair_colour = Color(0.1, 0.07, 0.06, 1)
shirt = Color(0.18, 0.56, 0.51, 1)
trousers = Color(0.54, 0.48, 0.33, 1)
place = ExtResource("4_place")
topics = Array[ExtResource("2_t")]([SubResource("Topic_0"), SubResource("Topic_1"), SubResource("Topic_2"), SubResource("Topic_3"), SubResource("Topic_4"), SubResource("Topic_5"), SubResource("Topic_6"), SubResource("Topic_7"), SubResource("Topic_8"), SubResource("Topic_9"), SubResource("Topic_10"), SubResource("Topic_11"), SubResource("Topic_12"), SubResource("Topic_13"), SubResource("Topic_14"), SubResource("Topic_15"), SubResource("Topic_16")])
