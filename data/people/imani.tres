[gd_resource type="Resource" script_class="PersonData" format=3]

[ext_resource type="Script" path="res://scripts/people/person_data.gd" id="1_p"]
[ext_resource type="Script" path="res://scripts/people/talk_topic.gd" id="2_t"]
[ext_resource type="Script" path="res://scripts/systems/objective_goal.gd" id="3_g"]
[ext_resource type="Texture2D" path="res://assets/buildings/people/dive_control.svg" id="4_place"]

[sub_resource type="Resource" id="Topic_0"]
script = ExtResource("2_t")
id = &"hello_far"
when = PackedStringArray("first", "flag:deep_mapped")
lines = PackedStringArray("You're {name}! You've mapped more of the deep than anyone. I'm Imani, the submarine pilot.")

[sub_resource type="Resource" id="Topic_1"]
script = ExtResource("2_t")
id = &"hello"
when = PackedStringArray("first")
lines = PackedStringArray("Hello, {name}. I'm Imani: I pilot the research submarine.", "Down there it's darker than any night you've ever seen.")

[sub_resource type="Resource" id="Topic_2"]
script = ExtResource("2_t")
id = &"ending"
when = PackedStringArray("flag:observatory_opened")
lines = PackedStringArray("We learned the most when we were quiet enough to listen.")

[sub_resource type="Resource" id="Goal_3"]
script = ExtResource("3_g")
kind = &"built"
target = &"deep_ocean_outpost"
island = &"deep_sea"
text = "Build the Deep-Ocean Outpost"

[sub_resource type="Resource" id="Topic_3"]
script = ExtResource("2_t")
id = &"outpost"
lines = PackedStringArray("What do you think lives in the dark?", "> Monsters? | Nothing at all?", "Ha! Let's find out. An outpost would let me take the submarine down. It's in your Build menu.")
objective = SubResource("Goal_3")
thanks = PackedStringArray("The outpost is up! Now we can go down.")
reminder = PackedStringArray("The Deep-Ocean Outpost is in your Build menu.")

[sub_resource type="Resource" id="Goal_4"]
script = ExtResource("3_g")
kind = &"flag"
target = &"deep_mapped"
text = "Map the deep (6 of the 8 dark areas) and bring the island to 70 %"

[sub_resource type="Resource" id="Topic_4"]
script = ExtResource("2_t")
id = &"mapped"
lines = PackedStringArray("The dark patches are deep water nobody has ever mapped. We can't protect what we don't understand.", "But lights and noise disturb the animals down there. How do you think we could learn without scaring them?", "> Quietly? | Very carefully?", "Exactly. Even helping takes wisdom. Bram the old captain knows these waters.")
objective = SubResource("Goal_4")
thanks = PackedStringArray("We've seen it! The deep is full of life we didn't know was there.")
reminder = PackedStringArray("How's the mapping going? Quiet buoys, careful cameras, or a dive from the outpost.")

[sub_resource type="Resource" id="Topic_5"]
script = ExtResource("2_t")
id = &"guess_whales"
when = PackedStringArray("asked:mapped")
lines = PackedStringArray("If we keep the water quiet, what do you think the whales will do?", "> Come closer! | Swim away.", "Let's listen and find out. Your guess is in your Journal.")
outcome_when = PackedStringArray("flag:deep_mapped")
outcome = "In the quiet water the whales stayed and kept on clicking. Listening first worked better than lighting everything up."

[sub_resource type="Resource" id="Goal_6"]
script = ExtResource("3_g")
kind = &"flag"
target = &"cargo_located"
text = "Find the lost cargo module"

[sub_resource type="Resource" id="Topic_6"]
script = ExtResource("2_t")
id = &"cargo"
lines = PackedStringArray("Something big shows up on the old shipping records: a cargo module lost down here years ago.", "Could we find it? Take the submarine down with me: an Echo Dive from the outpost. A Cargo search mission might find it too.")
objective = SubResource("Goal_6")
thanks = PackedStringArray("There it is! Now we need to bring it up.")
reminder = PackedStringArray("Try an Echo Dive at the outpost, or send a Cargo search from it.")

[sub_resource type="Resource" id="Goal_7"]
script = ExtResource("3_g")
kind = &"flag"
target = &"cargo_recovered"
text = "Tow the cargo module in with your boat"

[sub_resource type="Resource" id="Topic_7"]
script = ExtResource("2_t")
id = &"tow"
lines = PackedStringArray("Can you tow the module in with your boat? Gently: it's been down there a long time.")
objective = SubResource("Goal_7")
thanks = PackedStringArray("A cargo hold! Your ships can carry supplies between the islands now.")
reminder = PackedStringArray("Sail to the marked cargo module and tow it in.")

[sub_resource type="Resource" id="Goal_8"]
script = ExtResource("3_g")
kind = &"installed"
target = &"cargo_module"
text = "Build this island's Exploration Ship and fit the Cargo Module"

[sub_resource type="Resource" id="Topic_8"]
script = ExtResource("2_t")
id = &"ship"
lines = PackedStringArray("What do you think lies past these waters?", "> More islands? | Let's go and see!", "Build this island's Exploration Ship beside two dock planks, and fit the Cargo Module to it. Then we'd find out.")
objective = SubResource("Goal_8")
thanks = PackedStringArray("Where next, {name}? North, maybe. The ice holds secrets too.")
reminder = PackedStringArray("The Exploration Ship goes beside two dock planks, from the Build menu. Fit the Cargo Module at the ship (Explore).")

[sub_resource type="Resource" id="Goal_9"]
script = ExtResource("3_g")
kind = &"flag"
target = &"gear_recovered"
text = "Bring up 3 pieces of lost fishing gear"

[sub_resource type="Resource" id="Goal_9b"]
script = ExtResource("3_g")
kind = &"flag"
target = &"gear_traced"
text = "Find out where the lost gear comes from"

[sub_resource type="Resource" id="Goal_9c"]
script = ExtResource("3_g")
kind = &"stopped"
target = &"ghost_net"
text = "Stop the lost nets and line at their source"

[sub_resource type="Resource" id="Topic_9"]
script = ExtResource("2_t")
id = &"gear"
when = PackedStringArray("installed:cargo_module")
lines = PackedStringArray("Every lost net we've seen down there is still catching fish. Nobody's coming back for them.", "Who do you think lost them?", "> Fishing boats? | A storm?", "Let's find out. Bring up three pieces from the mapped areas with your boat, and we'll take a close look.")
objective = SubResource("Goal_9")
thanks = PackedStringArray("Three pieces, and not one with a name or a mark on it. Nobody could ever tell whose they were.")
reminder = PackedStringArray("Lost gear shows up in the mapped areas: bring up three pieces with your boat.")

[sub_resource type="Resource" id="Topic_9b"]
script = ExtResource("2_t")
id = &"trace"
when = PackedStringArray("installed:cargo_module")
lines = PackedStringArray("So where does it all come from, and why is it lost?", "> Old nets thrown away? | Nets torn off?", "The sub can follow the gear back. Send Trace the lost gear from the Outpost.")
objective = SubResource("Goal_9b")
thanks = PackedStringArray("Unmarked nets, and nowhere to take the old ones. No wonder they end up in the sea.")
reminder = PackedStringArray("Send Trace the lost gear from the Deep-Ocean Outpost, and we'll know where it comes from.")
marks = &"gear_asked"

[sub_resource type="Resource" id="Topic_9c"]
script = ExtResource("2_t")
id = &"netpoint"
when = PackedStringArray("installed:cargo_module")
lines = PackedStringArray("What if the fishers had somewhere to bring their old nets, and every new net carried its boat's mark?", "> Lost nets get found! | Ask Bram!", "Bram fished these waters for forty years. A Net Return Point by the dock would do both: it's in your Build menu.")
objective = SubResource("Goal_9c")
thanks = PackedStringArray("Old nets come back to be recycled, and a lost marked net gets reported and fetched. No new nets or line in the sea, anywhere.")
reminder = PackedStringArray("The Net Return Point is in your Build menu: old nets recycled, new ones marked.")

[sub_resource type="Resource" id="Topic_10"]
script = ExtResource("2_t")
id = &"chat"
lines = PackedStringArray("Where should we explore? I'm always ready for another dive.")

[sub_resource type="Resource" id="Obs_0"]
script = ExtResource("2_t")
id = &"whale_clicks"
when = PackedStringArray("animals:sperm_whale>=1")
lines = PackedStringArray("The hydrophones picked up the sperm whales' clicks again. They're some of the loudest sounds any animal makes, and every click helps us map the dark.")

[sub_resource type="Resource" id="Obs_1"]
script = ExtResource("2_t")
id = &"bait_sixgills"
when = PackedStringArray("built:deep_camera")
lines = PackedStringArray("Bait a deep camera and the sixgill sharks come to it; they're scavengers. But too many sixgills crowd the other animals out, so not too often.")

[resource]
script = ExtResource("1_p")
id = &"imani"
display_name = "Dr. Imani Osei"
short_name = "Imani"
job = "Pilot"
region = &"deep_sea"
role = &"objective"
spot = Vector2(15728, -72)
where = "at dive control"
moves_to = &""
moved_where = "at dive control"
place_offset = Vector2(-68, 6)
skin = Color(0.33, 0.2, 0.12, 1)
hair = 2
hair_colour = Color(0.08, 0.06, 0.05, 1)
shirt = Color(0.85, 0.45, 0.2, 1)
trousers = Color(0.2, 0.22, 0.26, 1)
place = ExtResource("4_place")
topics = Array[ExtResource("2_t")]([SubResource("Topic_0"), SubResource("Topic_1"), SubResource("Topic_2"), SubResource("Topic_3"), SubResource("Topic_4"), SubResource("Topic_5"), SubResource("Topic_6"), SubResource("Topic_7"), SubResource("Topic_8"), SubResource("Topic_9"), SubResource("Topic_9b"), SubResource("Topic_9c"), SubResource("Topic_10")])
observations = Array[ExtResource("2_t")]([SubResource("Obs_0"), SubResource("Obs_1")])
