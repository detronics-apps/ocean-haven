display_name = "Dr. Imani Osei"
short_name = "Imani"
job = "Pilot"
region = &"deep_sea"
role = &"objective"
spot = Vector2(15728, -72)
where = "by her equipment"
moves_to = &"deep_ocean_outpost"
moved_where = "by the outpost"
place_offset = Vector2(-54, 6)
skin = Color(0.33, 0.2, 0.12, 1)
hair = 2
hair_colour = Color(0.08, 0.06, 0.05, 1)
shirt = Color(0.85, 0.45, 0.2, 1)
trousers = Color(0.2, 0.22, 0.26, 1)
place = ExtResource("4_place")
topics = Array[ExtResource("2_t")]([SubResource("Topic_0"), SubResource("Topic_1"), SubResource("Topic_2"), SubResource("Topic_3"), SubResource("Topic_4"), SubResource("Topic_5"), SubResource("Topic_6"), SubResource("Topic_7"), SubResource("Topic_8"), SubResource("Topic_9"), SubResource("Topic_10")])
