[gd_resource type="Resource" script_class="PersonData" format=3]

[ext_resource type="Script" path="res://scripts/people/person_data.gd" id="1_p"]
[ext_resource type="Script" path="res://scripts/people/talk_topic.gd" id="2_t"]
[ext_resource type="Script" path="res://scripts/systems/objective_goal.gd" id="3_g"]
[ext_resource type="Texture2D" path="res://assets/buildings/people/field_camp.svg" id="4_place"]

[sub_resource type="Resource" id="Topic_0"]
script = ExtResource("2_t")
id = &"hello_far"
when = PackedStringArray("first", "flag:kelp_balanced")
lines = PackedStringArray("You're {name}? The one who brought the otters back? I'm Finn. I dive these waters.", "I used to dive for urchins to sell. I thought I was only taking urchins. Now I know what I'm part of.")

[sub_resource type="Resource" id="Topic_1"]
script = ExtResource("2_t")
id = &"hello"
when = PackedStringArray("first")
lines = PackedStringArray("Hi! You must be {name}. I'm Finn: I dive these waters.", "When I was a boy the kelp was so thick the sunlight came through green. Now it's mostly bare rock and urchins.")

[sub_resource type="Resource" id="Goal_2"]
script = ExtResource("3_g")
kind = &"built"
target = &"kelp_research_platform"
island = &"kelp_forest"
text = "Build the Kelp Research Platform"

[sub_resource type="Resource" id="Topic_2"]
script = ExtResource("2_t")
id = &"platform"
lines = PackedStringArray("What do you think happened to the kelp?", "> Something ate it? | A storm?", "That's what I want to find out. A research platform out on the water would let us dive and study it. It's in your Build menu.")
objective = SubResource("Goal_2")
thanks = PackedStringArray("A platform! Now we can see what's really going on down there.")
reminder = PackedStringArray("The Kelp Research Platform is in your Build menu. From there we can survey the whole forest.")

[sub_resource type="Resource" id="Goal_3"]
script = ExtResource("3_g")
kind = &"flag"
target = &"kelp_balanced"
text = "Bring the food web back into balance (island health 70 %)"

[sub_resource type="Resource" id="Topic_3"]
script = ExtResource("2_t")
id = &"balance"
lines = PackedStringArray("I used to dive for urchins to sell. I thought I was only taking urchins.", "Look at them now: they've eaten the kelp down to the rock. What do you think used to keep them in check?", "> Something that eats them? | I'm not sure.", "Let's count them first. Dive with me from the old jetty, and the platform's surveys will show the rest. Ines at the harbour might remember too.")
objective = SubResource("Goal_3")
thanks = PackedStringArray("Look at that patch! The kelp is growing back. I didn't understand what else depended on it.")
reminder = PackedStringArray("How's the forest doing? The platform's surveys show what's out of balance.")

[sub_resource type="Resource" id="Topic_4"]
script = ExtResource("2_t")
id = &"guess_kelp"
when = PackedStringArray("asked:balance")
lines = PackedStringArray("Here's something to watch. If the otters come back, what do you think happens to the kelp?", "> It grows back! | The otters eat it.", "We'll see. I've put your guess in your Journal.")
outcome_when = PackedStringArray("flag:kelp_balanced")
outcome = "The otters ate the urchins, not the kelp, and the kelp grew back. One animal coming back changed the whole forest."

[sub_resource type="Resource" id="Goal_5"]
script = ExtResource("3_g")
kind = &"count"
target = &"shed_kelp"
amount = 5
text = "Gather 5 pieces of shed kelp"

[sub_resource type="Resource" id="Topic_5"]
script = ExtResource("2_t")
id = &"shed"
lines = PackedStringArray("Healthy kelp sheds old fronds. They float up by the best beds every morning.", "Could you gather five? I've got an idea for them.")
objective = SubResource("Goal_5")
thanks = PackedStringArray("Five! Kelp fibre is tough stuff: strong enough to help your ships work under water.")
reminder = PackedStringArray("Shed kelp floats up by the healthiest beds each morning: pick it up, then sleep for more.")

[sub_resource type="Resource" id="Goal_6"]
script = ExtResource("3_g")
kind = &"installed"
target = &"kelp_fibre"
text = "Build this island's Exploration Ship and fit the Kelp Fibre"

[sub_resource type="Resource" id="Topic_6"]
script = ExtResource("2_t")
id = &"ship"
lines = PackedStringArray("What do you think lies past these waters?", "> More islands? | Let's go and see!", "Build this island's Exploration Ship beside two dock planks, and fit the Kelp Fibre to it. Then we'd find out.")
objective = SubResource("Goal_6")
thanks = PackedStringArray("Off you go, {name}. And the fish are back: I saw them myself.")
reminder = PackedStringArray("The Exploration Ship goes beside two dock planks, from the Build menu. Fit the Kelp Fibre at the ship (Explore).")

[sub_resource type="Resource" id="Goal_7"]
script = ExtResource("3_g")
kind = &"flag"
target = &"rings_traced"
text = "Find out where the plastic rings come from"

[sub_resource type="Resource" id="Topic_7"]
script = ExtResource("2_t")
id = &"rings"
when = PackedStringArray("installed:kelp_fibre", "picked:six_pack_rings>=12")
lines = PackedStringArray("{name}, I keep cutting plastic rings off the rocks where the otters rest. You've picked up {picked:six_pack_rings} yourself.", "Where do you think they come from?", "> The harbour? | Passing ships?", "Let's find out. The divers at the platform can follow the currents back: send Trace the rings.")
objective = SubResource("Goal_7")
thanks = PackedStringArray("The harbour cafe! Every drink comes in a can, and the cans come in rings.")
reminder = PackedStringArray("Send Trace the rings from the research platform.")
marks = &"rings_asked"

[sub_resource type="Resource" id="Goal_8"]
script = ExtResource("3_g")
kind = &"stopped"
target = &"six_pack_rings"
text = "Stop the plastic rings at their source"

[sub_resource type="Resource" id="Topic_8"]
script = ExtResource("2_t")
id = &"refill"
lines = PackedStringArray("Picking them up won't stop them coming. What could the cafe do instead?", "> No more cans? | Ask Ines!", "Ines has an idea, she told me. Talk to her: the Harbour Refill Bar is in your Build menu now.")
objective = SubResource("Goal_8")
thanks = PackedStringArray("No new rings on the otters' rocks. Drinks from kegs that go back to be filled, and cups that get washed.", "I used to think the problem was out here in the water. Some of it starts on land.")
reminder = PackedStringArray("The Harbour Refill Bar is in your Build menu. Ines knows how it works.")

[sub_resource type="Resource" id="Topic_9"]
script = ExtResource("2_t")
id = &"fish_back"
when = PackedStringArray("animals:blue_rockfish>=8")
lines = PackedStringArray("The fish are back. I swam right through a school of rockfish this morning.")

[sub_resource type="Resource" id="Topic_10"]
script = ExtResource("2_t")
id = &"chat"
lines = PackedStringArray("Something underwater not right? Come and tell me. I'll go and look.")

[resource]
script = ExtResource("1_p")
id = &"finn"
display_name = "Finn Larsen"
short_name = "Finn"
job = "Diver"
region = &"kelp_forest"
