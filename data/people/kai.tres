[gd_resource type="Resource" script_class="PersonData" format=3]

[ext_resource type="Script" path="res://scripts/people/person_data.gd" id="1_p"]
[ext_resource type="Script" path="res://scripts/people/talk_topic.gd" id="2_t"]
[ext_resource type="Script" path="res://scripts/systems/objective_goal.gd" id="3_g"]
[ext_resource type="Texture2D" path="res://assets/buildings/people/field_camp.svg" id="4_place"]

[sub_resource type="Resource" id="Topic_0"]
script = ExtResource("2_t")
id = &"hello_far"
when = PackedStringArray("first", "flag:reef_restored")
lines = PackedStringArray("{name}! The reef's alive again thanks to you. I'm Kai, the engineer around here.", "I keep wondering: how could we make things so they don't hurt the reef in the first place?")

[sub_resource type="Resource" id="Topic_1"]
script = ExtResource("2_t")
id = &"hello"
when = PackedStringArray("first")
lines = PackedStringArray("Hey, {name}! I'm Kai. I'm an engineer: I like working out how things could be made differently.")

[sub_resource type="Resource" id="Topic_2"]
script = ExtResource("2_t")
id = &"ending"
when = PackedStringArray("flag:observatory_opened")
lines = PackedStringArray("The best design was the one that didn't make the problem.")

[sub_resource type="Resource" id="Goal_3"]
script = ExtResource("3_g")
kind = &"built"
target = &"coral_restoration_lab"
island = &"tropical_reef"
text = "Build the Coral Restoration Laboratory"

[sub_resource type="Resource" id="Topic_3"]
script = ExtResource("2_t")
id = &"lab"
lines = PackedStringArray("The reef here is mostly grey rubble. What do you think a reef needs to grow back?", "> New coral? | Clean water?", "Probably both, and more. A coral restoration lab would help us find out. It's in your Build menu.")
objective = SubResource("Goal_3")
thanks = PackedStringArray("A lab! Let's see what this reef needs.")
reminder = PackedStringArray("The Coral Restoration Laboratory is in your Build menu.")

[sub_resource type="Resource" id="Goal_4"]
script = ExtResource("3_g")
kind = &"flag"
target = &"reef_restored"
text = "Bring the reef back to life (island health 70 %)"

[sub_resource type="Resource" id="Topic_4"]
script = ExtResource("2_t")
id = &"reef"
lines = PackedStringArray("Coral grows slowly, and only where the water is clear and something keeps the algae down.", "Who do you think does that work on a reef?", "> Fish? | Nobody?", "Let's find out. Leilani the dive guide knows every animal down there.")
objective = SubResource("Goal_4")
thanks = PackedStringArray("Colour! Real colour on the reef again.")
reminder = PackedStringArray("How's the reef? The lab's surveys show what it still needs.")

[sub_resource type="Resource" id="Topic_5"]
script = ExtResource("2_t")
id = &"guess_parrotfish"
when = PackedStringArray("asked:reef")
lines = PackedStringArray("Something to watch: what do you think parrotfish do to a reef?", "> Eat it up! | Make sand!", "Keep an eye on them. Your guess is in your Journal.")
outcome_when = PackedStringArray("flag:reef_restored")
outcome = "They scrape algae off the coral so young coral can grow, and grind up dead coral as they go. A lot of a reef's white sand has been through a parrotfish!"

[sub_resource type="Resource" id="Goal_6"]
script = ExtResource("3_g")
kind = &"count"
target = &"reef_limestone"
amount = 5
text = "Collect 5 pieces of dead coral rubble"

[sub_resource type="Resource" id="Topic_6"]
script = ExtResource("2_t")
id = &"rubble"
lines = PackedStringArray("Dead coral rubble lies on the sea floor by the reef. Never break living coral, but the rubble we can use.", "Could you collect five pieces from your boat?")
objective = SubResource("Goal_6")
thanks = PackedStringArray("Five! Reef limestone: perfect for a mapping system that can see the sea floor.")
reminder = PackedStringArray("Rubble lies by the reef each morning: pick it up from your boat.")

[sub_resource type="Resource" id="Goal_7"]
script = ExtResource("3_g")
kind = &"installed"
target = &"reef_limestone"
text = "Build this island's Exploration Ship and fit the Reef Limestone"

[sub_resource type="Resource" id="Topic_7"]
script = ExtResource("2_t")
id = &"ship"
lines = PackedStringArray("What do you think lies past these waters?", "> More islands? | Let's go and see!", "Build this island's Exploration Ship beside two dock planks, and fit the Reef Limestone to it. Then we'd find out.")
objective = SubResource("Goal_7")
thanks = PackedStringArray("Off you go, {name}. Maybe the best design is the one that doesn't create the problem.")
reminder = PackedStringArray("The Exploration Ship goes beside two dock planks, from the Build menu. Fit the Reef Limestone at the ship (Explore).")

[sub_resource type="Resource" id="Goal_8"]
script = ExtResource("3_g")
kind = &"stopped"
target = &"plastic_bottle"
text = "Stop the plastic bottles at their source"

[sub_resource type="Resource" id="Topic_8"]
script = ExtResource("2_t")
id = &"bottles"
when = PackedStringArray("installed:reef_limestone", "picked:plastic_bottle>=12")
lines = PackedStringArray("{picked:plastic_bottle} plastic bottles you've picked up! Each one was used once, and could last hundreds of years out there.", "What if nobody needed a new one?", "> Make our own? | Refill them?", "Glass lasts, and you can fill it again and again. Glass from the Glassworks, and clean water from the giant clams: reusable bottles.")
objective = SubResource("Goal_8")
thanks = PackedStringArray("No new bottles drifting in, on any island! The best design is the one that doesn't create the problem.")
reminder = PackedStringArray("Make glass at the Glassworks (3 sand), and clean water at the Marine Water Treatment Facility.")

[sub_resource type="Resource" id="Topic_9"]
script = ExtResource("2_t")
id = &"filters"
when = PackedStringArray("asked:filters")
lines = PackedStringArray("Sanna sent you about the fibres? A filter in a washing machine catches them before they go down the drain.", "Some countries are starting to require them. I've drawn the plans: the Filter Workshop is in your Build menu here.")

[sub_resource type="Resource" id="Topic_10"]
script = ExtResource("2_t")
id = &"chat"
lines = PackedStringArray("Want to know how we could make something differently? That's what I'm here for.")

