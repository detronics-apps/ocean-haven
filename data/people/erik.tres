[gd_resource type="Resource" script_class="PersonData" format=3]

[ext_resource type="Script" path="res://scripts/people/person_data.gd" id="1_p"]
[ext_resource type="Script" path="res://scripts/people/talk_topic.gd" id="2_t"]
[ext_resource type="Script" path="res://scripts/systems/objective_goal.gd" id="3_g"]
[ext_resource type="Texture2D" path="res://assets/buildings/people/hut.svg" id="4_place"]

[sub_resource type="Resource" id="Topic_0"]
script = ExtResource("2_t")
id = &"hello"
when = PackedStringArray("first")
lines = PackedStringArray("Hello, {name}. I'm Erik. I've written down the ice every day for thirty years.", "When I started, the ice stayed much longer. I've got it all in my notebooks.")

[sub_resource type="Resource" id="Topic_1"]
script = ExtResource("2_t")
id = &"ending"
when = PackedStringArray("flag:observatory_opened")
lines = PackedStringArray("My notebooks have a new page now: the year the ocean came back.")

[sub_resource type="Resource" id="Topic_2"]
script = ExtResource("2_t")
id = &"caught"
when = PackedStringArray("tangled>=1")
lines = PackedStringArray("Something's caught out there. Go gently: you can free it.")

[sub_resource type="Resource" id="Topic_3"]
script = ExtResource("2_t")
id = &"terns"
when = PackedStringArray("soon:terns_arriving")
lines = PackedStringArray("The terns come back early each spring, all the way from the far south. Thirty years, and they've never missed one.")

[sub_resource type="Resource" id="Topic_4"]
script = ExtResource("2_t")
id = &"old_ice"
when = PackedStringArray("!flag:polar_balanced")
lines = PackedStringArray("Pups need ice that lasts. The white ice in the middle never melts: that's the old ice.", "And boats break the thin ice while it freezes. Keep them out of the channels then.")

[sub_resource type="Resource" id="Topic_5"]
script = ExtResource("2_t")
id = &"on"
when = PackedStringArray("installed:ice_core")
lines = PackedStringArray("Go back to the Starting Island some time. Old Tom will want to hear all about it.")

[sub_resource type="Resource" id="Topic_6"]
script = ExtResource("2_t")
id = &"chat"
lines = PackedStringArray("The ice remembers everything. So do my notebooks.")

[sub_resource type="Resource" id="Obs_0"]
script = ExtResource("2_t")
id = &"skua_trouble"
when = PackedStringArray("animals:arctic_skua>=1")
lines = PackedStringArray("The skua circles over trouble. When you see it going round and round, something down there needs help.")

[sub_resource type="Resource" id="Obs_1"]
script = ExtResource("2_t")
id = &"rubbish_bears"
when = PackedStringArray("animals:polar_bear>=1", "!flag:bear_at_camp")
lines = PackedStringArray("A polar bear can smell food from a long way off. Keep rubbish away from the camp, or a bear will come to see what it is.")

[resource]
script = ExtResource("1_p")
scared_line = "Stay close, {name}, there's a bear about! Forty winters up here and they still make my heart race. It's the rubbish that drew it: clear that, and it'll leave on its own."
id = &"erik"
display_name = "Erik Holm"
short_name = "Erik"
job = "Weather watcher"
region = &"arctic_ocean"
role = &"hint"
spot = Vector2(25232, 24)
where = "at the weather hut"
place_offset = Vector2(-56, 8)
skin = Color(0.92, 0.78, 0.68, 1)
hair = 0
hair_colour = Color(0.8, 0.8, 0.8, 1)
shirt = Color(0.3, 0.45, 0.6, 1)
trousers = Color(0.25, 0.25, 0.3, 1)
hat = 2
hat_colour = Color(0.6, 0.2, 0.2, 1)
place = ExtResource("4_place")
topics = Array[ExtResource("2_t")]([SubResource("Topic_0"), SubResource("Topic_1"), SubResource("Topic_2"), SubResource("Topic_3"), SubResource("Topic_4"), SubResource("Topic_5"), SubResource("Topic_6")])
observations = Array[ExtResource("2_t")]([SubResource("Obs_0"), SubResource("Obs_1")])
