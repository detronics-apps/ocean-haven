[gd_resource type="Resource" script_class="PersonData" format=3]

[ext_resource type="Script" path="res://scripts/people/person_data.gd" id="1_p"]
[ext_resource type="Script" path="res://scripts/people/talk_topic.gd" id="2_t"]
[ext_resource type="Script" path="res://scripts/systems/objective_goal.gd" id="3_g"]
[ext_resource type="Texture2D" path="res://assets/buildings/people/field_camp.svg" id="4_place"]

[sub_resource type="Resource" id="Topic_0"]
script = ExtResource("2_t")
id = &"hello_far"
when = PackedStringArray("first", "flag:polar_balanced")
lines = PackedStringArray("{name}, isn't it? You've helped this ice through its seasons. I'm Sanna, the expedition leader.")

[sub_resource type="Resource" id="Topic_1"]
script = ExtResource("2_t")
id = &"hello"
when = PackedStringArray("first")
lines = PackedStringArray("Welcome to the ice, {name}. I'm Sanna. I lead the expedition here.", "Out here everything moves with the seasons: the ice, the seals, the bears, the birds.")

[sub_resource type="Resource" id="Topic_2"]
script = ExtResource("2_t")
id = &"ending"
when = PackedStringArray("flag:observatory_opened")
lines = PackedStringArray("There was only ever one ocean.")

[sub_resource type="Resource" id="Goal_3"]
script = ExtResource("3_g")
kind = &"built"
target = &"polar_research_station"
island = &"arctic_ocean"
text = "Build the Polar Research Station"

[sub_resource type="Resource" id="Topic_3"]
script = ExtResource("2_t")
id = &"station"
lines = PackedStringArray("Some of this ice is older than anyone alive. What do you think it remembers?", "> The weather long ago? | Nothing?", "Layers and layers of it! First we need a research station, on the rock. It's in your Make menu.")
objective = SubResource("Goal_3")
thanks = PackedStringArray("The station is up. Now we can watch the ice through the year.")
reminder = PackedStringArray("The Polar Research Station goes on rock: it's in your Make menu.")

[sub_resource type="Resource" id="Goal_4"]
script = ExtResource("3_g")
kind = &"flag"
target = &"polar_balanced"
text = "Help the Polar Ocean through the seasons (island health 70 %)"

[sub_resource type="Resource" id="Topic_4"]
script = ExtResource("2_t")
id = &"seasons"
lines = PackedStringArray("The ice freezes and melts every season here. What do you think a seal pup needs from the ice?", "> Ice that lasts? | Lots of fish?", "Let's find out. Erik has watched the ice for thirty years.")
objective = SubResource("Goal_4")
thanks = PackedStringArray("Pups on the old ice, and a bear crossing the frozen channel. This ocean's coming back.")
reminder = PackedStringArray("How are the seals and bears doing? The station's surveys show which ice will last.")

[sub_resource type="Resource" id="Topic_5"]
script = ExtResource("2_t")
id = &"guess_pups"
when = PackedStringArray("asked:seasons")
lines = PackedStringArray("A seal pup is born on ice that melts in the thaw. What do you think happens?", "> It's fine. | It loses its home.", "Let's watch through a season. Your guess is in your Journal.")
outcome_when = PackedStringArray("flag:polar_balanced")
outcome = "Pups born on old ice, ice that lasts through the thaw, grew up safely. Ice that melts too soon is a hard place to start life."

[sub_resource type="Resource" id="Goal_6"]
script = ExtResource("3_g")
kind = &"flag"
target = &"ice_core_drilled"
text = "Drill an ice core on old ice (3 days)"

[sub_resource type="Resource" id="Topic_6"]
script = ExtResource("2_t")
id = &"core"
lines = PackedStringArray("Now for the old ice's memory. A drill site on old ice could bring up a core from deep inside.", "It needs ice that lasts for three days while it drills. Help me plan it on the station's ice map: an Ice Match.")
objective = SubResource("Goal_6")
thanks = PackedStringArray("An ice core! Every layer is a year. This ocean connects the whole planet, and now we can read it.")
reminder = PackedStringArray("Plan it with an Ice Match at the station, then build the Ice Core Drill Site on old ice and keep it there for 3 days.")

[sub_resource type="Resource" id="Goal_7"]
script = ExtResource("3_g")
kind = &"installed"
target = &"ice_core"
text = "Fit the Ice Core at one of your Exploration Ships"

[sub_resource type="Resource" id="Topic_7"]
script = ExtResource("2_t")
id = &"fit_core"
lines = PackedStringArray("What do you think your ships could learn from the old ice?", "> About the climate? | About the whole ocean?", "Both! Fit the Ice Core at any of your Exploration Ships (Explore), and the whole fleet can read it.")
objective = SubResource("Goal_7")
thanks = PackedStringArray("Your fleet has all six now, {name}. Every island taught us something different.")
reminder = PackedStringArray("Fit the Ice Core at any Exploration Ship: walk up to it and choose Explore.")

[sub_resource type="Resource" id="Goal_8"]
script = ExtResource("3_g")
kind = &"flag"
target = &"fibres_traced"
text = "Find out what the threads in the ice are"

[sub_resource type="Resource" id="Topic_8"]
script = ExtResource("2_t")
id = &"fibres"
when = PackedStringArray("installed:ice_core")
lines = PackedStringArray("The ice core shows something strange: tiny coloured threads, in the newer layers.", "What do you think they are?", "> Plastic? | Bits of seaweed?", "Let's look closer. Send Look at the fibres from the station.")
objective = SubResource("Goal_8")
thanks = PackedStringArray("Plastic microfibres from washing clothes, all the way out here. The freezing ice traps them.")
reminder = PackedStringArray("Send Look at the fibres from the research station.")
marks = &"fibres_asked"

[sub_resource type="Resource" id="Goal_9"]
script = ExtResource("3_g")
kind = &"stopped"
target = &"microfibres"
text = "Catch the microfibres before they reach the sea"

[sub_resource type="Resource" id="Topic_9"]
script = ExtResource("2_t")
id = &"filters"
lines = PackedStringArray("The fibres come from laundry far away. How could we catch them before they reach the sea?", "> A filter? | Ask Kai!", "Kai the engineer at the Tropical Reef has been drawing a filter for washing machines. Build his Filter Workshop there.")
objective = SubResource("Goal_9")
thanks = PackedStringArray("Filters! The fibres are caught in every wash, before they reach the sea.", "It only works because so many people help. That's true of everything we've done.")
reminder = PackedStringArray("Kai's Filter Workshop is in the Make menu on the Tropical Reef.")

[sub_resource type="Resource" id="Topic_10"]
script = ExtResource("2_t")
id = &"chat"
lines = PackedStringArray("What does this mean for the whole ocean? That's the question I can't stop asking.")

[sub_resource type="Resource" id="Obs_0"]
script = ExtResource("2_t")
id = &"seals_old_ice"
when = PackedStringArray("animals:ringed_seal>=1")
lines = PackedStringArray("Ringed seals raise their pups in snow dens on ice that lasts. Pupping on seasonal ice is risky: it melts before the pups are ready.")

[sub_resource type="Resource" id="Obs_1"]
script = ExtResource("2_t")
id = &"terns_travel"
when = PackedStringArray()
lines = PackedStringArray("Arctic terns make the longest migration of any animal. Ours fly off to your other islands in the freeze, if those are healthy enough to feed them.")

[sub_resource type="Resource" id="Obs_2"]
script = ExtResource("2_t")
id = &"seal_young"
when = PackedStringArray("young:ringed_seal>=1")
lines = PackedStringArray("A ringed seal pup, all white and woolly! It's born in a snow den on the ice, hidden from the bears.")

[resource]
script = ExtResource("1_p")
scared_line = "{name}! There's a polar bear right by camp! It must smell the rubbish lying about. Please clear it up, quickly, and it'll wander back to the ice."
id = &"sanna"
display_name = "Dr. Sanna Lind"
short_name = "Sanna"
job = "Expedition leader"
region = &"arctic_ocean"
role = &"objective"
storm_worry = "{name}, a snowstorm's coming, and the ice is groaning. Big pieces could break away! Keep the pupping zones and drill site on old ice, and secure the buildings."
storm_after = "That was incredible, {name}! The whole floe cracked right in front of me, and the snow came sideways. Rubbish blown everywhere, and some things got damaged. Can you help clean up and fix them?"
spot = Vector2(25264, -40)
where = "by her expedition camp"
moves_to = &"polar_research_station"
moved_where = "by the research station"
place_offset = Vector2(-68, 6)
skin = Color(0.95, 0.82, 0.72, 1)
hair = 2
hair_colour = Color(0.75, 0.55, 0.3, 1)
shirt = Color(0.8, 0.25, 0.25, 1)
trousers = Color(0.2, 0.2, 0.25, 1)
hat = 1
hat_colour = Color(0.85, 0.85, 0.9, 1)
place = ExtResource("4_place")
topics = Array[ExtResource("2_t")]([SubResource("Topic_0"), SubResource("Topic_1"), SubResource("Topic_2"), SubResource("Topic_3"), SubResource("Topic_4"), SubResource("Topic_5"), SubResource("Topic_6"), SubResource("Topic_7"), SubResource("Topic_8"), SubResource("Topic_9"), SubResource("Topic_10")])
observations = Array[ExtResource("2_t")]([SubResource("Obs_0"), SubResource("Obs_1"), SubResource("Obs_2")])
