[gd_resource type="Resource" script_class="PersonData" format=3]

[ext_resource type="Script" path="res://scripts/people/person_data.gd" id="1_p"]
[ext_resource type="Script" path="res://scripts/people/talk_topic.gd" id="2_t"]
[ext_resource type="Script" path="res://scripts/systems/objective_goal.gd" id="3_g"]
[ext_resource type="Texture2D" path="res://assets/buildings/people/hut.svg" id="4_place"]

[sub_resource type="Resource" id="Topic_0"]
script = ExtResource("2_t")
id = &"hello"
when = PackedStringArray("first")
lines = PackedStringArray("Aloha, {name}! I'm Leilani. I take people diving here.", "I know where every current goes, and where it dumps its rubbish.")

[sub_resource type="Resource" id="Topic_1"]
script = ExtResource("2_t")
id = &"ending"
when = PackedStringArray("flag:observatory_opened")
lines = PackedStringArray("The reef's full of colour again. Every dive is different.")

[sub_resource type="Resource" id="Topic_2"]
script = ExtResource("2_t")
id = &"caught"
when = PackedStringArray("tangled>=1")
lines = PackedStringArray("Something's caught out there. Go gently: you can free it.")

[sub_resource type="Resource" id="Topic_3"]
script = ExtResource("2_t")
id = &"spawning"
when = PackedStringArray("soon:coral_spawning")
lines = PackedStringArray("Early in summer, on a few nights after dark, the whole reef spawns at once. Come and watch from the water at night!")

[sub_resource type="Resource" id="Topic_4"]
script = ExtResource("2_t")
id = &"shark"
when = PackedStringArray("animals:reef_shark>=1")
lines = PackedStringArray("The shark isn't the trouble. Follow it: it's circling something caught down there.")

[sub_resource type="Resource" id="Topic_5"]
script = ExtResource("2_t")
id = &"coral"
when = PackedStringArray("!flag:reef_restored")
lines = PackedStringArray("Parrotfish graze the algae off the reef so young coral can grow. And giant clams clean the water.", "Grow coral fragments, plant them on the reef from your boat, and give the reef animals a home.")

[sub_resource type="Resource" id="Topic_6"]
script = ExtResource("2_t")
id = &"litter"
when = PackedStringArray("litter>12")
lines = PackedStringArray("The lagoon keeps catching litter. Clear water lets the coral grow faster.")

[sub_resource type="Resource" id="Topic_7"]
script = ExtResource("2_t")
id = &"on"
when = PackedStringArray("installed:reef_limestone")
lines = PackedStringArray("If you ever go to the Deep Sea, look for Bram. He's an old captain with a lot of stories.")

[sub_resource type="Resource" id="Topic_8"]
script = ExtResource("2_t")
id = &"chat"
lines = PackedStringArray("Every dive here is different. That's what I love about it.")

[sub_resource type="Resource" id="Obs_0"]
script = ExtResource("2_t")
id = &"shark_gear"
when = PackedStringArray("animals:reef_shark>=1")
lines = PackedStringArray("If the reef shark keeps circling the same spot, take a look there. There's often lost fishing gear hidden in the coral.")

[sub_resource type="Resource" id="Obs_1"]
script = ExtResource("2_t")
id = &"turtle_seagrass"
when = PackedStringArray("built:seagrass_protection_area")
lines = PackedStringArray("Green turtles graze the seagrass like cows on a lawn. Grazed seagrass grows back thicker, so turtles help the seahorses' meadows.")

[sub_resource type="Resource" id="Want"]
script = ExtResource("2_t")
id = &"want"
when = PackedStringArray()
lines = PackedStringArray("When I was a new dive guide, I saw the coral spawn: pink clouds rising on a summer night.", "I want my divers to see it too.")
outcome_when = PackedStringArray("flag:seen_coral_spawning")
outcome = "My divers saw the coral spawn, {name}. One of them cried. So did I, a little."

[resource]
script = ExtResource("1_p")
id = &"leilani"
display_name = "Leilani Kahale"
short_name = "Leilani"
job = "Dive guide"
region = &"tropical_reef"
role = &"hint"
storm_worry = "The sea's gone all strange, {name}, and the fish have dived deep. A hurricane's coming! Secure your buildings and stay safe."
storm_after = "Wow, {name}, that hurricane! I hid in the dive shop the whole time. Now there's litter everywhere, on the sand and in the water. Help me clean it up and fix the damage?"
spot = Vector2(19952, 152)
where = "at the dive shack"
place_offset = Vector2(-56, 8)
skin = Color(0.72, 0.5, 0.35, 1)
hair = 1
hair_colour = Color(0.15, 0.1, 0.08, 1)
shirt = Color(0.2, 0.65, 0.7, 1)
trousers = Color(0.95, 0.9, 0.8, 1)
place = ExtResource("4_place")
topics = Array[ExtResource("2_t")]([SubResource("Topic_0"), SubResource("Topic_1"), SubResource("Topic_2"), SubResource("Topic_3"), SubResource("Topic_4"), SubResource("Topic_5"), SubResource("Topic_6"), SubResource("Topic_7"), SubResource("Topic_8")])
observations = Array[ExtResource("2_t")]([SubResource("Obs_0"), SubResource("Obs_1")])
want = SubResource("Want")
visit_line = "Hello from the {island}, {name}! {host} is showing me what lives here."
