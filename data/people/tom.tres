[gd_resource type="Resource" script_class="PersonData" format=3]

[ext_resource type="Script" path="res://scripts/people/person_data.gd" id="1_p"]
[ext_resource type="Script" path="res://scripts/people/talk_topic.gd" id="2_t"]
[ext_resource type="Script" path="res://scripts/systems/objective_goal.gd" id="3_g"]
[ext_resource type="Texture2D" path="res://assets/buildings/people/lighthouse.svg" id="4_place"]

[sub_resource type="Resource" id="Topic_0"]
script = ExtResource("2_t")
id = &"hello_far"
when = PackedStringArray("first", "animals:green_turtle>=6")
lines = PackedStringArray("So you're {name}, the ranger who brought the turtles back. I'm Tom. I've kept this light for fifty years.", "I watch the beach every night from up there. It hasn't looked like this since I was a boy.")

[sub_resource type="Resource" id="Topic_1"]
script = ExtResource("2_t")
id = &"hello"
when = PackedStringArray("first")
lines = PackedStringArray("A new ranger! {name}, isn't it? I'm Tom. I've kept this lighthouse for fifty years.", "When I was a boy, this beach was covered in turtle tracks every summer. Now I hardly see any.", "Turtles need a quiet stretch of sand to nest. Maybe you could give them one?")

[sub_resource type="Resource" id="Topic_2"]
script = ExtResource("2_t")
id = &"ending"
when = PackedStringArray("flag:observatory_opened")
lines = PackedStringArray("Fifty years I've watched this beach. I never thought I'd see it come back. Now I've a new story to tell.")

[sub_resource type="Resource" id="Topic_3"]
script = ExtResource("2_t")
id = &"tracks"
when = PackedStringArray("nests>=1")
lines = PackedStringArray("My father could tell where turtles had been just by looking at the sand.", "> How? | Footprints?", "Tracks! A turtle crawls up from the sea to lay her eggs and leaves a trail behind her. Go and look by your turtle area.")
once = true
marks = &"tracks_noticed"

[sub_resource type="Resource" id="Topic_4"]
script = ExtResource("2_t")
id = &"crates"
when = PackedStringArray("asked:boxes")
lines = PackedStringArray("Foam boxes? In my father's day the fish came ashore in wooden crates with the boat's name burned into the side.", "Every crate went back to its boat. A box that comes back is better than one you throw away.")

[sub_resource type="Resource" id="Topic_5"]
script = ExtResource("2_t")
id = &"caught"
when = PackedStringArray("tangled>=1")
lines = PackedStringArray("I saw something caught out there from the top of the light. Go gently: you can free it.")

[sub_resource type="Resource" id="Topic_6"]
script = ExtResource("2_t")
id = &"wood"
when = PackedStringArray("asked:station", "!built:marine_rescue_station")
lines = PackedStringArray("Maya sent you? Building takes wood, and this island is full of palms.", "Cut down a full-grown palm and you'll get wood and saplings. Plant a sapling for every tree you cut: the birds nest in them.")

[sub_resource type="Resource" id="Topic_7"]
script = ExtResource("2_t")
id = &"no_area"
when = PackedStringArray("!built:turtle_protection_area")
lines = PackedStringArray("Turtles need a quiet stretch of sand. When I was young, the top of the beach was theirs.", "Somewhere nobody builds right next to. A Turtle Protection Area, maybe?")

[sub_resource type="Resource" id="Topic_8"]
script = ExtResource("2_t")
id = &"busy"
when = PackedStringArray("busy:turtle_protection_area>=1")
lines = PackedStringArray("Your turtle area is too busy. A turtle won't come ashore with buildings right beside her.", "Give her a couple of tiles of quiet sand all round.")

[sub_resource type="Resource" id="Topic_9"]
script = ExtResource("2_t")
id = &"off_season"
when = PackedStringArray("!season:spring", "built:turtle_protection_area", "animals:green_turtle<10")
lines = PackedStringArray("Turtles nest in spring. Till then, keep their beach quiet and the water clean.", "And most of the little ones swim far out to sea. Only a few stay near the island they hatched on.")

[sub_resource type="Resource" id="Topic_10"]
script = ExtResource("2_t")
id = &"litter"
when = PackedStringArray("litter>12")
lines = PackedStringArray("The litter always comes in on the same tide. Catch it out on the water, before it reaches the beach.")

[sub_resource type="Resource" id="Topic_11"]
script = ExtResource("2_t")
id = &"wreck"
when = PackedStringArray("built:marine_rescue_station", "!flag:wreck_found")
lines = PackedStringArray("Maya's been staring at her old charts again.", "When I was young, the beam of this light used to catch something out west, past the point.")

[sub_resource type="Resource" id="Topic_12"]
script = ExtResource("2_t")
id = &"turtles_full"
when = PackedStringArray("animals:green_turtle>=10")
lines = PackedStringArray("{count:green_turtle} turtles. I didn't think I'd see this again.", "Now I have something new to remember.")

[sub_resource type="Resource" id="Topic_13"]
script = ExtResource("2_t")
id = &"turtles_many"
when = PackedStringArray("animals:green_turtle>=6")
lines = PackedStringArray("{count:green_turtle} turtles! I haven't seen that many since my father's day.")

[sub_resource type="Resource" id="Topic_14"]
script = ExtResource("2_t")
id = &"nests_back"
when = PackedStringArray("nests>=1")
lines = PackedStringArray("Nests on the beach again. I counted them from up there this morning.")

[sub_resource type="Resource" id="Topic_15"]
script = ExtResource("2_t")
id = &"few_turtles"
when = PackedStringArray("animals:green_turtle<3")
lines = PackedStringArray("I haven't seen many turtle tracks lately. They need quiet sand, and clean water to come back to.")

[sub_resource type="Resource" id="Topic_16"]
script = ExtResource("2_t")
id = &"far_waters"
when = PackedStringArray("installed:salvaged_sonar_core")
lines = PackedStringArray("Wherever you sail, look for the people who've watched those waters longest. They remember what they used to be.")

[sub_resource type="Resource" id="Topic_17"]
script = ExtResource("2_t")
id = &"light"
lines = PackedStringArray("The light's still turning. Come by any time.")

[resource]
script = ExtResource("1_p")
id = &"tom"
display_name = "Tom Pieters"
short_name = "Tom"
job = "Lighthouse keeper"
region = &"home_island"
role = &"hint"
spot = Vector2(-48, 372)
where = "at the lighthouse"
