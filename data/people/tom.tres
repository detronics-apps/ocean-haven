skin = Color(0.88, 0.67, 0.54, 1)
hair = 0
hair_colour = Color(0.9, 0.9, 0.9, 1)
shirt = Color(0.17, 0.24, 0.4, 1)
trousers = Color(0.23, 0.25, 0.28, 1)
hat = 2
hat_colour = Color(0.17, 0.24, 0.4, 1)
place = ExtResource("4_place")
topics = Array[ExtResource("2_t")]([SubResource("Topic_0"), SubResource("Topic_1"), SubResource("Topic_2"), SubResource("Topic_3"), SubResource("Topic_4"), SubResource("Topic_5"), SubResource("Topic_6"), SubResource("Topic_7"), SubResource("Topic_8"), SubResource("Topic_9"), SubResource("Topic_10"), SubResource("Topic_11"), SubResource("Topic_12"), SubResource("Topic_13"), SubResource("Topic_14"), SubResource("Topic_15"), SubResource("Topic_16"), SubResource("Topic_17")])
