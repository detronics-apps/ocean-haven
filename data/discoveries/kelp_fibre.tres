[ext_resource type="Script" path="res://scripts/systems/discovery_data.gd" id="1_disc"]

[resource]
script = ExtResource("1_disc")
id = &"kelp_fibre"
display_name = "Kelp Fibre"
order = 2
description = "Strong fibre from kelp the forest shed naturally, gathered once the forest was healthy again."
