[ext_resource type="Texture2D" path="res://assets/animals/polar_bear/polar_bear.svg" id="2_t"]

[ext_resource type="Script" path="res://scripts/animals/photo_moment.gd" id="pm_script"]
[ext_resource type="Texture2D" path="res://assets/animals/polar_bear/polar_bear_resting.svg" id="rest_1411"]
