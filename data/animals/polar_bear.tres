[ext_resource type="Texture2D" path="res://assets/animals/polar_bear/polar_bear_young.svg" id="young_1"]

[sub_resource type="Resource" id="Moment_0"]
script = ExtResource("pm_script")
id = &"ice"
title = "Walking on the ice"
when = PackedStringArray("adult", "on:ice")

[sub_resource type="Resource" id="Moment_1"]
script = ExtResource("pm_script")
id = &"swimming"
title = "Swimming between floes"
when = PackedStringArray("adult", "on:water")

[sub_resource type="Resource" id="Moment_2"]
script = ExtResource("pm_script")
id = &"lying"
title = "Lying down to rest"
when = PackedStringArray("resting_pose")

[sub_resource type="Resource" id="Moment_3"]
script = ExtResource("pm_script")
id = &"cub"
title = "A cub"
when = PackedStringArray("baby")

[sub_resource type="Resource" id="Moment_4"]
script = ExtResource("pm_script")
id = &"young"
title = "A young bear"
when = PackedStringArray("juvenile")

[resource]
script = ExtResource("1_s")
short_name = "Bear"
resting_sprite = ExtResource("rest_1411")
id = &"polar_bear"
display_name = "Polar Bear"
sprite = ExtResource("2_t")
habitat = "Arctic sea ice, coasts and islands"
diet = "Mostly seals, hunted from the sea ice"
role = "Stays with a Quiet Den Area and a frozen path between the floes."
fact = "Polar bears hunt from the sea ice, so they need the ice to join their resting places to the seals' waters. When the ice breaks up they wait on land until it freezes again."
photo_fact = "Under its white fur a polar bear's skin is black, which soaks up the sun's warmth."
help_fact = "Give it quiet rock to rest on (a Quiet Den Area), and keep boats out of the channels while the ice freezes, so a corridor of ice forms."
habitat_terrain = PackedStringArray("ice", "rock")
faces_movement = false
swim_speed = 26.0
shy_distance = 90.0
discover_distance = 200.0
curious = false
interact_distance = 140.0
lives_at = &"quiet_den_area"
adult_home_radius = 160.0
moments = Array[ExtResource("pm_script")]([SubResource("Moment_0"), SubResource("Moment_1"), SubResource("Moment_2"), SubResource("Moment_3"), SubResource("Moment_4")])
grow_days = 6.0
young_sprites = Array[Texture2D]([ExtResource("young_0"), ExtResource("young_1")])
