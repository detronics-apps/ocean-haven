[resource]
script = ExtResource("1_s")
id = &"parrotfish"
display_name = "Parrotfish"
sprite = ExtResource("2_t")
habitat = "Coral reefs"
diet = "Algae scraped off coral and rock"
fact = "Parrotfish bite off bits of coral rock with their beak-like teeth and grind them up. What comes out is fine white sand: a big parrotfish can make hundreds of kilos of sand a year."
photo_fact = "At night some parrotfish wrap themselves in a bubble of mucus, like a sleeping bag."
help_fact = "Litter smothers the reef that parrotfish feed on. Clean water keeps them feeding, and their sand building up."
