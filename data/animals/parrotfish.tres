[gd_resource type="Resource" script_class="AnimalData" format=3]

[ext_resource type="Script" path="res://scripts/animals/animal_data.gd" id="1_s"]
[ext_resource type="Texture2D" path="res://assets/animals/parrotfish/parrotfish.svg" id="2_t"]

[ext_resource type="Script" path="res://scripts/animals/photo_moment.gd" id="pm_script"]

[sub_resource type="Resource" id="Moment_0"]
script = ExtResource("pm_script")
id = &"grazing"
title = "Grazing the reef by day"
when = PackedStringArray("day")

[sub_resource type="Resource" id="Moment_1"]
script = ExtResource("pm_script")
id = &"sleeping"
title = "Asleep at night"
when = PackedStringArray("night")

[resource]
script = ExtResource("1_s")
roams = true
id = &"parrotfish"
display_name = "Parrotfish"
sprite = ExtResource("2_t")
habitat = "Coral reefs"
diet = "Algae scraped off coral and rock"
role = "Grazes algae off the reef and grinds coral into sand: the sand the Glassworks needs."
fact = "Parrotfish bite off bits of coral rock with their beak-like teeth and grind them up. What comes out is fine white sand: a big parrotfish can make hundreds of kilos of sand a year."
photo_fact = "At night some parrotfish wrap themselves in a bubble of mucus, like a sleeping bag."
help_fact = "Litter smothers the reef that parrotfish feed on. Clean water keeps them feeding, and their sand building up."
habitat_terrain = PackedStringArray("", "water")
swim_speed = 34.0
curious = false
discover_distance = 120.0
interact_distance = 90.0
moments = Array[ExtResource("pm_script")]([SubResource("Moment_0"), SubResource("Moment_1")])
drifts_in = true
