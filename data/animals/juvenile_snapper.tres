[ext_resource type="Texture2D" path="res://assets/animals/snapper/juvenile_snapper.svg" id="2_t"]

[ext_resource type="Script" path="res://scripts/animals/photo_moment.gd" id="pm_script"]

[sub_resource type="Resource" id="Moment_0"]
script = ExtResource("pm_script")
id = &"day"
title = "In a nursery pool by day"
when = PackedStringArray("day")

[sub_resource type="Resource" id="Moment_1"]
script = ExtResource("pm_script")
id = &"night"
title = "In a nursery pool at night"
when = PackedStringArray("night")

[resource]
script = ExtResource("1_s")
short_name = "Snapper"
id = &"juvenile_snapper"
display_name = "Young Mangrove Snapper"
sprite = ExtResource("2_t")
habitat = "Mangrove pools and channels while young; coral reefs once grown"
diet = "Tiny shrimp, crabs and small fish"
role = "Grows up in the nursery pools once they're joined to the sea."
fact = "Grey (mangrove) snappers grow up hiding among mangrove roots, then swim out to coral reefs as adults. Mangroves are a nursery for many reef fish."
photo_fact = "The tangle of mangrove roots keeps young fish safe from big predators."
help_fact = "Young fish need pools that stay connected to the sea, so they can swim out when they are grown."
habitat_terrain = PackedStringArray("water")
swim_speed = 36.0
shy_distance = 50.0
discover_distance = 110.0
curious = false
interact_distance = 80.0
grow_days = 2.0
moments = Array[ExtResource("pm_script")]([SubResource("Moment_0"), SubResource("Moment_1")])
drifts_in = true
