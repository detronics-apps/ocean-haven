[sub_resource type="Resource" id="Moment_0"]
script = ExtResource("pm_script")
id = &"flying"
title = "In flight"
when = PackedStringArray("flying")

[sub_resource type="Resource" id="Moment_1"]
script = ExtResource("pm_script")
id = &"nest"
title = "On its nest"
when = PackedStringArray("perched")

[resource]
script = ExtResource("1_boo")
icon = ExtResource("rest_3043")
floating_sprite = ExtResource("floa_8091")
resting_sprite = ExtResource("rest_3043")
id = &"red_footed_booby"
display_name = "Red-footed Booby"
sprite = ExtResource("2_boo")
habitat = "Tropical islands and open ocean; nests in trees and bushes"
diet = "Flying fish and squid, caught by diving into the sea"
role = "Nests in palms you planted, and circles over floating litter to show you where it is."
fact = "Red-footed boobies are the smallest boobies, and they build their nests of twigs in trees and bushes, so they need the island's trees."
photo_fact = "Their name may come from the Spanish word 'bobo', meaning silly, because they were so tame around sailors."
help_fact = "Seabirds can get caught in lost fishing line. Picking up line from the beach and the water keeps them safe."
habitat_terrain = PackedStringArray("", "water", "sand", "grass")
swim_speed = 60.0
rest_min = 0.5
rest_max = 1.5
shy_distance = 48.0
discover_distance = 140.0
calm_speed = 40.0
curious = false
interact_distance = 80.0
flies = true
nests_in_trees = true
perched_sprite = ExtResource("3_boo")
circles_litter = true
can_tangle = true
moments = Array[ExtResource("pm_script")]([SubResource("Moment_0"), SubResource("Moment_1")])
travel_home = &"home_island"
travels_to = PackedStringArray("tropical_reef")
travel_chance = 0.35
travel_news = "Boobies were fishing off the reef this morning! Red-footed boobies, all the way from the {from}."
seeds_tree = ExtResource("seed_palm")
seeds_from = &"home_island"
seeds_to = &"tropical_reef"
seeds_news = "Have you seen? A little palm has come up on the island, the first tree we've ever had here! The boobies from the {from} must have brought the seed."
grow_days = 4.0
