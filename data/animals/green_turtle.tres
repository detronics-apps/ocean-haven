[gd_resource type="Resource" script_class="AnimalData" format=3]

[ext_resource type="Script" path="res://scripts/animals/animal_data.gd" id="1_6nm75"]
[ext_resource type="Texture2D" path="res://assets/animals/turtle/green_turtle.svg" id="2_5ypsb"]

[ext_resource type="Script" path="res://scripts/animals/photo_moment.gd" id="pm_script"]

[sub_resource type="Resource" id="Moment_0"]
script = ExtResource("pm_script")
id = &"swimming"
title = "Swimming in the sea"
when = PackedStringArray("adult", "on:water")

[sub_resource type="Resource" id="Moment_1"]
script = ExtResource("pm_script")
id = &"nesting"
title = "Nesting on the beach"
when = PackedStringArray("nesting")

[sub_resource type="Resource" id="Moment_2"]
script = ExtResource("pm_script")
id = &"hatchling"
title = "A hatchling"
when = PackedStringArray("young")

[resource]
script = ExtResource("1_6nm75")
roams = true
travel_home = &"home_island"
travels_to = PackedStringArray("mangrove_coast", "tropical_reef")
travel_chance = 0.3
travel_news = "A green turtle was grazing the seagrass this morning. I think it swam here from the {from}."
id = &"green_turtle"
display_name = "Green Sea Turtle"
sprite = ExtResource("2_5ypsb")
habitat = "Tropical and subtropical oceans"
diet = "Seagrass and algae"
role = "Nests on quiet beaches: give them a Turtle Protection Area and the hatchlings come."
fact = "Sea turtles can travel thousands of kilometres during their lives."
photo_fact = "Scientists can recognise individual sea turtles from the unique pattern of scales on their faces."
help_fact = "Lost fishing line can trap turtles. Rangers are trained to free them safely - if you ever see a tangled animal, tell a lifeguard or a wildlife rescue team."
nest_building = &"turtle_protection_area"
nest_fact = "A green turtle lays around 100 eggs in each nest, then returns to the sea."
hatch_fact = "Hatchlings find the sea by heading for the brightest horizon - that's why bright beach lights can confuse them."
can_tangle = true
boat_shy_distance = 120.0
nest_interval_days = 4
nest_season = &"spring"
off_season_interval_days = 40
nests_from_next_season = true
stay_per_nest = 1
grow_days = 8.0
moments = Array[ExtResource("pm_script")]([SubResource("Moment_0"), SubResource("Moment_1"), SubResource("Moment_2")])
