[gd_resource type="Resource" script_class="AnimalData" format=3]

[ext_resource type="Script" path="res://scripts/animals/animal_data.gd" id="1_s"]
[ext_resource type="Texture2D" path="res://assets/animals/shark/sixgill_shark.svg" id="2_t"]

[ext_resource type="Script" path="res://scripts/animals/photo_moment.gd" id="pm_script"]

[sub_resource type="Resource" id="Moment_0"]
script = ExtResource("pm_script")
id = &"dark"
title = "In the deep"
when = PackedStringArray("underwater")

[sub_resource type="Resource" id="Moment_1"]
script = ExtResource("pm_script")
id = &"rising"
title = "Coming up from the deep"
when = PackedStringArray("surfaced")

[resource]
script = ExtResource("1_s")
id = &"sixgill_shark"
display_name = "Bluntnose Sixgill Shark"
sprite = ExtResource("2_t")
habitat = "Deep water along slopes and ledges, rising nearer the surface at night"
diet = "Fish, squid, crabs, and dead animals that sink from above"
fact = "Most sharks have five gill slits; the bluntnose sixgill has six. Baited cameras, a real way scientists study the deep, draw sixgills in from far away."
photo_fact = "Its eyes glow green in the light: they're made to catch the faintest glimmer in the deep."
help_fact = "Sixgills get hooked on lost longlines. A shark seen with a hook in its jaw shows there's lost fishing line nearby."
habitat_terrain = PackedStringArray("")
swim_speed = 36.0
shy_distance = 70.0
discover_distance = 150.0
curious = false
interact_distance = 100.0
dives = true
surface_seconds = Vector2(4, 7)
dive_seconds = Vector2(5, 9)
can_tangle = true
adult_home_radius = 240.0
moments = Array[ExtResource("pm_script")]([SubResource("Moment_0"), SubResource("Moment_1")])
