[gd_resource type="Resource" script_class="AnimalData" format=3]

[ext_resource type="Script" path="res://scripts/animals/animal_data.gd" id="1_s"]
[ext_resource type="Texture2D" path="res://assets/animals/whale/sperm_whale.svg" id="2_t"]

[ext_resource type="Script" path="res://scripts/animals/photo_moment.gd" id="pm_script"]

[sub_resource type="Resource" id="Moment_0"]
script = ExtResource("pm_script")
id = &"surface"
title = "Resting at the surface"
when = PackedStringArray("surfaced")

[sub_resource type="Resource" id="Moment_1"]
script = ExtResource("pm_script")
id = &"diving"
title = "Diving into the deep"
when = PackedStringArray("underwater")

[sub_resource type="Resource" id="Moment_2"]
script = ExtResource("pm_script")
id = &"passing"
title = "Passing by in autumn"
when = PackedStringArray("event:whales_passing")

[resource]
script = ExtResource("1_s")
roams = true
travel_home = &"deep_sea"
travels_to = PackedStringArray("arctic_ocean", "kelp_forest", "home_island", "mangrove_coast", "tropical_reef")
travel_chance = 0.25
travel_news = "A blow on the horizon this morning, slanting forward: a sperm whale, a long way from the {from}!"
id = &"sperm_whale"
display_name = "Sperm Whale"
sprite = ExtResource("2_t")
habitat = "The deep open ocean, diving more than a kilometre down"
diet = "Squid, including giant squid, and deep-sea fish"
role = "Stays where the deep is quiet; its clicks help the hydrophones map the dark."
fact = "Sperm whales make the loudest sounds of any animal: clicks they use like sonar to find squid in the dark. Hydrophones listening to those clicks show where the whales are feeding."
photo_fact = "It breathes through one blowhole on the left of its head, so its blow slants forward and to the left."
help_fact = "Lost fishing line can wrap round a whale's tail or flippers. Noise from boats and machines drowns out the clicks it hunts with, so it moves to quieter water."
habitat_terrain = PackedStringArray("")
swim_speed = 34.0
shy_distance = 90.0
discover_distance = 220.0
curious = false
interact_distance = 130.0
dives = true
surface_seconds = Vector2(6, 10)
dive_seconds = Vector2(8, 14)
boat_shy_distance = 120.0
can_tangle = true
adult_home_radius = 260.0
moments = Array[ExtResource("pm_script")]([SubResource("Moment_0"), SubResource("Moment_1"), SubResource("Moment_2")])
