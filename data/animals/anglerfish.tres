[gd_resource type="Resource" script_class="AnimalData" format=3]

[ext_resource type="Script" path="res://scripts/animals/animal_data.gd" id="1_s"]
[ext_resource type="Texture2D" path="res://assets/animals/anglerfish/anglerfish.svg" id="2_t"]

[ext_resource type="Script" path="res://scripts/animals/photo_moment.gd" id="pm_script"]

[sub_resource type="Resource" id="Moment_0"]
script = ExtResource("pm_script")
id = &"dark"
title = "Its lure glowing in the dark"
when = PackedStringArray("underwater")

[sub_resource type="Resource" id="Moment_1"]
script = ExtResource("pm_script")
id = &"rising"
title = "Near the surface"
when = PackedStringArray("surfaced")

[resource]
script = ExtResource("1_s")
id = &"anglerfish"
display_name = "Deep-sea Anglerfish"
sprite = ExtResource("2_t")
habitat = "The dark deep sea, where no sunlight reaches"
diet = "Fish and shrimp drawn in by its glowing lure"
fact = "The lure on a female anglerfish's head is full of glowing bacteria. Its light draws prey close in the dark, and its glow lets deep cameras see animals without bright lamps."
photo_fact = "Anglerfish wait almost without moving, saving energy where food is scarce."
help_fact = "Bright lights from cameras and submarines drive it away from where it hunts."
habitat_terrain = PackedStringArray("")
faces_movement = false
swim_speed = 14.0
shy_distance = 50.0
discover_distance = 120.0
curious = false
interact_distance = 90.0
dives = true
surface_seconds = Vector2(5, 8)
dive_seconds = Vector2(5, 9)
adult_home_radius = 90.0
moments = Array[ExtResource("pm_script")]([SubResource("Moment_0"), SubResource("Moment_1")])
