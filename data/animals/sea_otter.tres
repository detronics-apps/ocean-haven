[ext_resource type="Texture2D" path="res://assets/animals/otter/sea_otter_young.svg" id="young_1"]

[sub_resource type="Resource" id="Moment_0"]
script = ExtResource("pm_script")
id = &"floating"
title = "Floating on its back"
when = PackedStringArray("resting_pose")

[sub_resource type="Resource" id="Moment_1"]
script = ExtResource("pm_script")
id = &"carrying"
title = "Carrying litter ashore"
when = PackedStringArray("carrying")

[sub_resource type="Resource" id="Moment_2"]
script = ExtResource("pm_script")
id = &"swimming"
title = "Swimming"
when = PackedStringArray("swimming")

[sub_resource type="Resource" id="Moment_3"]
script = ExtResource("pm_script")
id = &"pup"
title = "A pup"
when = PackedStringArray("baby")

[sub_resource type="Resource" id="Moment_4"]
script = ExtResource("pm_script")
id = &"young"
title = "A young otter"
when = PackedStringArray("juvenile")

[resource]
script = ExtResource("1_otter")
short_name = "Otter"
roams = true
resting_sprite = ExtResource("rest_1201")
id = &"sea_otter"
display_name = "Sea Otter"
sprite = ExtResource("spri_9759")
habitat = "Cool coastal waters with kelp forests; they rest in the kelp canopy"
diet = "Sea urchins, crabs, clams and other shellfish"
role = "Eats urchins so the kelp can grow back, and carries floating litter ashore. Lives at Otter Habitats."
fact = "A sea otter eats about a quarter of its own weight in food every day. By keeping urchin numbers down, otters protect whole kelp forests."
photo_fact = "Sea otters often wrap themselves in kelp while they sleep, so they don't drift away."
help_fact = "Lost fishing nets and line can trap otters. Picking up fishing litter keeps them safe."
habitat_terrain = PackedStringArray("", "water")
swim_speed = 34.0
shy_distance = 60.0
discover_distance = 130.0
interact_distance = 90.0
boat_shy_distance = 100.0
can_tangle = true
grow_days = 4.0
adult_home_radius = 120.0
lives_at = &"otter_habitat"
settles_near = &"kelp_beds"
urchins_per_day = 4.0
forage_range = 260.0
food_needed = 4.0
kelp_food = 3.0
carries_litter_ashore = true
moments = Array[ExtResource("pm_script")]([SubResource("Moment_0"), SubResource("Moment_1"), SubResource("Moment_2"), SubResource("Moment_3"), SubResource("Moment_4")])
young_sprites = Array[Texture2D]([ExtResource("young_0"), ExtResource("young_1")])
