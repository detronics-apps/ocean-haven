[gd_resource type="Resource" script_class="AnimalData" format=3]

[ext_resource type="Script" path="res://scripts/animals/animal_data.gd" id="1_s"]
[ext_resource type="Texture2D" path="res://assets/animals/clam/giant_clam.svg" id="2_t"]

[ext_resource type="Script" path="res://scripts/animals/photo_moment.gd" id="pm_script"]

[sub_resource type="Resource" id="Moment_0"]
script = ExtResource("pm_script")
id = &"open"
title = "Open in the sunlight"
when = PackedStringArray("day")

[sub_resource type="Resource" id="Moment_1"]
script = ExtResource("pm_script")
id = &"night"
title = "At night"
when = PackedStringArray("night")

[sub_resource type="Resource" id="Moment_2"]
script = ExtResource("pm_script")
id = &"spawning"
title = "On the night the reef spawns"
when = PackedStringArray("event:coral_spawning")
bonus = true

[sub_resource type="Resource" id="Moment_3"]
script = ExtResource("pm_script")
id = &"near_boat"
title = "Close to your boat"
when = PackedStringArray("near_boat")

[resource]
script = ExtResource("1_s")
short_name = "Clam"
faces_movement = false
id = &"giant_clam"
display_name = "Giant Clam"
sprite = ExtResource("2_t")
habitat = "Shallow coral reefs"
diet = "Sugars from algae living in its body, and plankton it filters from the water"
role = "Cleans the water. In a Water Treatment Facility it makes clean water for you."
fact = "Giant clams are the biggest clams in the world and can live for over 100 years. They filter seawater, cleaning it as they feed."
photo_fact = "A giant clam's blue and green colours come from tiny algae living in its body, which make food from sunlight."
help_fact = "Giant clams need clean, calm water and protection: a treatment facility gives them a safe bed."
habitat_terrain = PackedStringArray("water")
swim_speed = 2.0
rest_min = 20.0
rest_max = 40.0
shy_distance = 10.0
curious = false
discover_distance = 100.0
interact_distance = 70.0
lives_at = &"water_treatment_facility"
moments = Array[ExtResource("pm_script")]([SubResource("Moment_0"), SubResource("Moment_1"), SubResource("Moment_3"), SubResource("Moment_2")])
drifts_in = true
