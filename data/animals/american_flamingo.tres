[gd_resource type="Resource" script_class="AnimalData" format=3]

[ext_resource type="Script" path="res://scripts/animals/animal_data.gd" id="1_s"]
[ext_resource type="Texture2D" path="res://assets/animals/flamingo/american_flamingo.svg" id="2_t"]
[ext_resource type="Texture2D" path="res://assets/animals/flamingo/american_flamingo_resting.svg" id="3_t"]
[ext_resource type="Texture2D" path="res://assets/animals/flamingo/american_flamingo_flying.svg" id="4_t"]

[ext_resource type="Script" path="res://scripts/animals/photo_moment.gd" id="pm_script"]
[ext_resource type="Texture2D" path="res://assets/animals/flamingo/american_flamingo_sitting.svg" id="perc_99"]

[sub_resource type="Resource" id="Moment_0"]
script = ExtResource("pm_script")
id = &"feeding"
title = "Feeding in the shallows"
when = PackedStringArray("on:water", "day")

[sub_resource type="Resource" id="Moment_1"]
script = ExtResource("pm_script")
id = &"night"
title = "Resting at night"
when = PackedStringArray("night")

[resource]
script = ExtResource("1_s")
shows_water_level = true
perched_sprite = ExtResource("perc_99")
id = &"american_flamingo"
display_name = "American Flamingo"
sprite = ExtResource("2_t")
habitat = "Shallow, muddy flats and lagoons"
diet = "Brine shrimp, small snails and algae, filtered from the water"
role = "Feeds and nests when the water level is just right: its legs show you the level (set it with Water Gates)."
fact = "Flamingos feed with their heads upside down, filtering food out of the shallow water with their bills. Their pink colour comes from the food they eat."
photo_fact = "Flamingos build nests of mud: a little mound with a hollow on top for a single egg."
help_fact = "Flamingos need the water on the flats to be just right: too deep and they cannot feed, too dry and there is no food."
habitat_terrain = PackedStringArray("mud", "water")
faces_movement = false
resting_sprite = ExtResource("3_t")
flying_sprite = ExtResource("4_t")
swim_speed = 26.0
rest_min = 3.0
rest_max = 7.0
shy_distance = 70.0
discover_distance = 140.0
curious = false
interact_distance = 100.0
boat_shy_distance = 80.0
moments = Array[ExtResource("pm_script")]([SubResource("Moment_0"), SubResource("Moment_1")])
