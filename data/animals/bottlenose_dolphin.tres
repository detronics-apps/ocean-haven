[gd_resource type="Resource" script_class="AnimalData" format=3]

[ext_resource type="Script" path="res://scripts/animals/animal_data.gd" id="1_2r22d"]
[ext_resource type="Texture2D" path="res://assets/animals/dolphin/dolphin.svg" id="2_t780o"]

[ext_resource type="Script" path="res://scripts/animals/photo_moment.gd" id="pm_script"]

[sub_resource type="Resource" id="Moment_0"]
script = ExtResource("pm_script")
id = &"surfacing"
title = "Coming up for air"
when = PackedStringArray("surfaced")

[sub_resource type="Resource" id="Moment_1"]
script = ExtResource("pm_script")
id = &"guiding"
title = "Leading you to litter"
when = PackedStringArray("guiding")

[sub_resource type="Resource" id="Moment_2"]
script = ExtResource("pm_script")
id = &"boat"
title = "Swimming beside your boat"
when = PackedStringArray("near_boat")

[resource]
script = ExtResource("1_2r22d")
travel_home = &"home_island"
travels_to = PackedStringArray("kelp_forest", "mangrove_coast", "tropical_reef", "deep_sea")
travel_chance = 0.35
travel_news = "Did you see the dolphins out past the shallows this morning? Bottlenose dolphins, come all the way from the {from}!"
id = &"bottlenose_dolphin"
display_name = "Bottlenose Dolphin"
sprite = ExtResource("2_t780o")
habitat = "Warm and temperate seas all over the world"
diet = "Fish and squid"
role = "Play with one and it leads you to floating litter. Keeps away from busy patrol boats."
fact = "Dolphins breathe air through a blowhole on the top of their heads."
photo_fact = "Scientists recognise individual dolphins by the nicks and notches on their dorsal fins."
help_fact = "Lost 'ghost nets' can trap dolphins, turtles and seals. Rangers free them carefully - if you ever see a trapped animal, tell a lifeguard or wildlife rescue team."
gift_text = "has found some litter - follow it!"
habitat_terrain = PackedStringArray("", "water")
swim_speed = 70.0
rest_min = 1.0
rest_max = 3.0
shy_distance = 36.0
discover_distance = 160.0
calm_speed = 200.0
interact_distance = 100.0
dives = true
guides_to_litter = true
can_tangle = true
boat_shy_distance = 200.0
moments = Array[ExtResource("pm_script")]([SubResource("Moment_0"), SubResource("Moment_1"), SubResource("Moment_2")])
