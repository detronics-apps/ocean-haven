[gd_resource type="Resource" script_class="AnimalData" format=3]

[ext_resource type="Script" path="res://scripts/animals/animal_data.gd" id="1_s"]
[ext_resource type="Texture2D" path="res://assets/animals/crab/mangrove_crab.svg" id="2_t"]

[ext_resource type="Script" path="res://scripts/animals/photo_moment.gd" id="pm_script"]
[ext_resource type="Texture2D" path="res://assets/animals/crab/mangrove_crab_baby.svg" id="young_0"]
[ext_resource type="Texture2D" path="res://assets/animals/crab/mangrove_crab_young.svg" id="young_1"]

[sub_resource type="Resource" id="Moment_0"]
script = ExtResource("pm_script")
id = &"mud"
title = "On the mud by day"
when = PackedStringArray("day")

[sub_resource type="Resource" id="Moment_1"]
script = ExtResource("pm_script")
id = &"night"
title = "Out at night"
when = PackedStringArray("night")

[resource]
script = ExtResource("1_s")
id = &"mangrove_crab"
display_name = "Mangrove Crab"
sprite = ExtResource("2_t")
habitat = "Mud banks among the mangrove roots"
diet = "Fallen mangrove leaves, and tiny creatures in the mud"
role = "A few keep the channels from silting up; too many make it worse. Crab Habitats give them a home."
fact = "Mangrove crabs eat fallen mangrove leaves and drag them into their burrows, recycling the leaves into food for the whole mangrove."
photo_fact = "Crab burrows let air and water into the mud, which helps mangrove roots breathe."
help_fact = "Plastic caught among mangrove roots can trap crabs. Picking it up keeps the mud banks safe."
habitat_terrain = PackedStringArray("mud")
faces_movement = false
swim_speed = 40.0
rest_min = 1.0
rest_max = 4.0
discover_distance = 100.0
calm_speed = 30.0
curious = false
interact_distance = 70.0
can_tangle = true
lives_at = &"crab_habitat"
grow_days = 2.0
adult_home_radius = 80.0
moments = Array[ExtResource("pm_script")]([SubResource("Moment_0"), SubResource("Moment_1")])
young_sprites = Array[Texture2D]([ExtResource("young_0"), ExtResource("young_1")])
