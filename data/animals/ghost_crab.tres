[gd_resource type="Resource" script_class="AnimalData" format=3]

[ext_resource type="Script" path="res://scripts/animals/animal_data.gd" id="1_chj40"]
[ext_resource type="Texture2D" path="res://assets/animals/crab/ghost_crab.svg" id="2_btkom"]

[ext_resource type="Script" path="res://scripts/animals/photo_moment.gd" id="pm_script"]

[sub_resource type="Resource" id="Moment_0"]
script = ExtResource("pm_script")
id = &"digging"
title = "Digging up the beach"
when = PackedStringArray("digging")

[sub_resource type="Resource" id="Moment_1"]
script = ExtResource("pm_script")
id = &"night"
title = "Out on the beach at night"
when = PackedStringArray("night", "on:land")

[sub_resource type="Resource" id="Moment_2"]
script = ExtResource("pm_script")
id = &"day"
title = "On the sand by day"
when = PackedStringArray("day", "on:sand")

[resource]
script = ExtResource("1_chj40")
id = &"ghost_crab"
display_name = "Ghost Crab"
sprite = ExtResource("2_btkom")
habitat = "Sandy tropical beaches"
diet = "Clams, insects and scraps washed up by the sea"
role = "Digs up litter buried in the beach. Can get caught in plastic bags."
fact = "Ghost crabs dig burrows in the sand and come out mostly at night."
photo_fact = "Crabs walk sideways because their legs bend best that way - it's their fastest way to scuttle."
help_fact = "Plastic bags on beaches can trap small animals like crabs. Every piece of litter you pick up helps."
gift_text = "dug up buried litter! Collect it and recycle it into turtle fences."
habitat_terrain = PackedStringArray("sand")
faces_movement = false
swim_speed = 45.0
rest_min = 1.0
rest_max = 4.0
discover_distance = 100.0
calm_speed = 30.0
curious = false
interact_distance = 70.0
digs_up_litter = true
can_tangle = true
moments = Array[ExtResource("pm_script")]([SubResource("Moment_0"), SubResource("Moment_1"), SubResource("Moment_2")])
