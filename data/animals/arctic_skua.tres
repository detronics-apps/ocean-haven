[gd_resource type="Resource" script_class="AnimalData" format=3]

[ext_resource type="Script" path="res://scripts/animals/animal_data.gd" id="1_s"]
[ext_resource type="Texture2D" path="res://assets/animals/skua/arctic_skua.svg" id="2_t"]

[ext_resource type="Script" path="res://scripts/animals/photo_moment.gd" id="pm_script"]
[ext_resource type="Texture2D" path="res://assets/animals/skua/arctic_skua_standing.svg" id="rest_889"]
[ext_resource type="Texture2D" path="res://assets/animals/skua/arctic_skua_floating.svg" id="floa_557"]
[ext_resource type="Texture2D" path="res://assets/animals/skua/arctic_skua_sitting.svg" id="perc_8752"]
[ext_resource type="Texture2D" path="res://assets/animals/skua/arctic_skua_baby.svg" id="young_0"]
[ext_resource type="Texture2D" path="res://assets/animals/skua/arctic_skua_young.svg" id="young_1"]

[sub_resource type="Resource" id="Moment_0"]
script = ExtResource("pm_script")
id = &"flying"
title = "In flight"
when = PackedStringArray("flying")

[sub_resource type="Resource" id="Moment_1"]
script = ExtResource("pm_script")
id = &"standing"
title = "Standing"
when = PackedStringArray("standing")

[sub_resource type="Resource" id="Moment_2"]
script = ExtResource("pm_script")
id = &"resting"
title = "Resting on the ground or the sea"
when = PackedStringArray("resting")

[sub_resource type="Resource" id="Moment_3"]
script = ExtResource("pm_script")
id = &"chick"
title = "A chick"
when = PackedStringArray("baby")

[sub_resource type="Resource" id="Moment_4"]
script = ExtResource("pm_script")
id = &"young"
title = "A young skua"
when = PackedStringArray("juvenile")

[resource]
script = ExtResource("1_s")
icon = ExtResource("rest_889")
perched_sprite = ExtResource("perc_8752")
floating_sprite = ExtResource("floa_557")
resting_sprite = ExtResource("rest_889")
id = &"arctic_skua"
display_name = "Arctic Skua"
sprite = ExtResource("2_t")
habitat = "Arctic coasts and open sea"
diet = "Fish, often chased off other seabirds"
role = "Circles over trouble: follow it to animals that need help."
fact = "Skuas notice everything going on in a seabird colony: where they gather shows where something is happening."
photo_fact = "Arctic skuas chase terns and gulls in the air until they drop their fish."
help_fact = "Watch where the skua circles: it shows where something needs your help."
habitat_terrain = PackedStringArray("rock", "ice", "water", "")
swim_speed = 66.0
shy_distance = 70.0
discover_distance = 150.0
curious = false
flies = true
circles_litter = true
adult_home_radius = 300.0
moments = Array[ExtResource("pm_script")]([SubResource("Moment_0"), SubResource("Moment_1"), SubResource("Moment_2"), SubResource("Moment_3"), SubResource("Moment_4")])
grow_days = 2.0
young_sprites = Array[Texture2D]([ExtResource("young_0"), ExtResource("young_1")])
