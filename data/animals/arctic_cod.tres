[ext_resource type="Script" path="res://scripts/animals/photo_moment.gd" id="pm_script"]

[sub_resource type="Resource" id="Moment_0"]
script = ExtResource("pm_script")
id = &"day"
title = "Under the ice by day"
when = PackedStringArray("day")

[sub_resource type="Resource" id="Moment_1"]
script = ExtResource("pm_script")
id = &"night"
title = "At night"
when = PackedStringArray("night")

[resource]
script = ExtResource("1_s")
short_name = "Cod"
roams = true
id = &"arctic_cod"
display_name = "Arctic Cod"
sprite = ExtResource("2_t")
habitat = "Under the edge of the sea ice"
diet = "Tiny shrimp-like animals that live on the underside of the ice"
role = "Follows the ice, and feeds the seals and terns."
fact = "Arctic cod shelter under the sea ice and feed on the tiny animals living on it. Seals, seabirds, whales and, through the seals, polar bears all depend on them."
photo_fact = "Its blood holds a natural antifreeze, so it can live in water colder than 0 C."
help_fact = "The more ice edge there is in the freeze, the more cod, and the more food for everyone."
habitat_terrain = PackedStringArray("", "water")
swim_speed = 34.0
shy_distance = 50.0
discover_distance = 110.0
curious = false
moments = Array[ExtResource("pm_script")]([SubResource("Moment_0"), SubResource("Moment_1")])
drifts_in = true
