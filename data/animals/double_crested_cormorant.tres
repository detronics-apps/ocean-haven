[resource]
script = ExtResource("1_corm")
short_name = "Cormorant"
lays_eggs = true
icon = ExtResource("rest_5796")
floating_sprite = ExtResource("floa_2326")
resting_sprite = ExtResource("rest_5796")
id = &"double_crested_cormorant"
display_name = "Double-crested Cormorant"
sprite = ExtResource("2_corm")
habitat = "Coasts and lakes; nests in trees and on rocky islands"
diet = "Fish, caught by diving and swimming underwater"
role = "Follows the fish, and needs full-grown trees to nest in."
fact = "Cormorants eat fish, so when the kelp and its fish recover, you see it at the surface: more cormorants."
photo_fact = "Cormorants' feathers get wet when they dive, which helps them swim underwater; afterwards they stand with their wings spread to dry them."
help_fact = "Fishing line left in the water can catch diving birds. Picking it up keeps them safe."
habitat_terrain = PackedStringArray("", "water", "sand", "grass")
swim_speed = 55.0
rest_min = 0.5
rest_max = 1.5
shy_distance = 48.0
discover_distance = 140.0
curious = false
flies = true
nests_in_trees = true
perched_sprite = ExtResource("3_corm")
can_tangle = true
moments = Array[ExtResource("pm_script")]([SubResource("Moment_0"), SubResource("Moment_1"), SubResource("Moment_2"), SubResource("Moment_3"), SubResource("Moment_4")])
grow_days = 4.0
young_sprites = Array[Texture2D]([ExtResource("young_0"), ExtResource("young_1")])
