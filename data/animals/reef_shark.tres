[gd_resource type="Resource" script_class="AnimalData" format=3]

[ext_resource type="Script" path="res://scripts/animals/animal_data.gd" id="1_s"]
[ext_resource type="Texture2D" path="res://assets/animals/shark/reef_shark.svg" id="2_t"]

[ext_resource type="Script" path="res://scripts/animals/photo_moment.gd" id="pm_script"]

[sub_resource type="Resource" id="Moment_0"]
script = ExtResource("pm_script")
id = &"day"
title = "Patrolling the reef by day"
when = PackedStringArray("day")

[sub_resource type="Resource" id="Moment_1"]
script = ExtResource("pm_script")
id = &"night"
title = "Hunting at night"
when = PackedStringArray("night")

[resource]
script = ExtResource("1_s")
short_name = "Shark"
roams = true
id = &"reef_shark"
display_name = "Blacktip Reef Shark"
sprite = ExtResource("2_t")
habitat = "Shallow lagoons and reef edges"
diet = "Small fish, squid and shrimp"
role = "Circles lost ghost gear: follow it to find the gear."
fact = "Blacktip reef sharks are shy and rarely bother people. As top predators they keep reef fish populations healthy."
photo_fact = "Look for the black tip on its dorsal fin, sticking out of the shallow water."
help_fact = "Lost fishing line and nets can catch sharks. Sharks circling oddly may have found some."
habitat_terrain = PackedStringArray("", "water")
swim_speed = 46.0
shy_distance = 80.0
discover_distance = 150.0
curious = false
interact_distance = 100.0
boat_shy_distance = 90.0
can_tangle = true
lives_at = &"shark_protection_zone"
adult_home_radius = 220.0
moments = Array[ExtResource("pm_script")]([SubResource("Moment_0"), SubResource("Moment_1")])
grow_days = 4.0
