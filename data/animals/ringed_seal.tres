[gd_resource type="Resource" script_class="AnimalData" format=3]

[ext_resource type="Script" path="res://scripts/animals/animal_data.gd" id="1_s"]
[ext_resource type="Texture2D" path="res://assets/animals/seal/ringed_seal.svg" id="2_t"]

[ext_resource type="Script" path="res://scripts/animals/photo_moment.gd" id="pm_script"]
[ext_resource type="Texture2D" path="res://assets/animals/seal/ringed_seal_land.svg" id="3_land"]
[ext_resource type="Texture2D" path="res://assets/animals/seal/ringed_seal_baby.svg" id="young_0"]
[ext_resource type="Texture2D" path="res://assets/animals/seal/ringed_seal_young.svg" id="young_1"]

[sub_resource type="Resource" id="Moment_0"]
script = ExtResource("pm_script")
id = &"ice"
title = "Resting on the ice"
when = PackedStringArray("adult", "on:ice")

[sub_resource type="Resource" id="Moment_1"]
script = ExtResource("pm_script")
id = &"swimming"
title = "Swimming"
when = PackedStringArray("adult", "on:water")

[sub_resource type="Resource" id="Moment_2"]
script = ExtResource("pm_script")
id = &"pup"
title = "A pup"
when = PackedStringArray("baby")

[sub_resource type="Resource" id="Moment_3"]
script = ExtResource("pm_script")
id = &"young"
title = "A young seal"
when = PackedStringArray("juvenile")

[resource]
script = ExtResource("1_s")
roams = true
id = &"ringed_seal"
display_name = "Ringed Seal"
sprite = ExtResource("2_t")
habitat = "Arctic sea ice and the water beneath it"
diet = "Arctic cod, shrimp and other small animals"
role = "Has its pups on old ice, in Seal Pupping Zones. Too many eat the cod down."
fact = "Ringed seals raise their pups in snow dens on the sea ice, so they need ice that lasts until the pups can swim. They keep breathing holes open through the ice with the claws on their flippers."
photo_fact = "The pale rings on its fur give it its name."
help_fact = "Pups need ice that lasts: a pupping zone on thin seasonal ice melts away before they're ready."
habitat_terrain = PackedStringArray("ice", "water", "")
swim_speed = 55.0
land_sprite = ExtResource("3_land")
land_speed = 0.3
shy_distance = 60.0
discover_distance = 130.0
curious = false
interact_distance = 90.0
can_tangle = true
lives_at = &"seal_pupping_zone"
adult_home_radius = 120.0
moments = Array[ExtResource("pm_script")]([SubResource("Moment_0"), SubResource("Moment_1"), SubResource("Moment_2"), SubResource("Moment_3")])
grow_days = 4.0
young_sprites = Array[Texture2D]([ExtResource("young_0"), ExtResource("young_1")])
