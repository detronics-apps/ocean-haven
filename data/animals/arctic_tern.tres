[ext_resource type="Texture2D" path="res://assets/animals/tern/arctic_tern.png" id="2_t"]

[ext_resource type="Script" path="res://scripts/animals/photo_moment.gd" id="pm_script"]
[ext_resource type="Texture2D" path="res://assets/animals/tern/arctic_tern_sitting.svg" id="3_sit"]
[ext_resource type="Texture2D" path="res://assets/animals/tern/arctic_tern_standing.svg" id="4_stand"]
[ext_resource type="Texture2D" path="res://assets/animals/tern/arctic_tern_floating.svg" id="5_float"]
[ext_resource type="Texture2D" path="res://assets/animals/tern/arctic_tern_baby.svg" id="young_0"]
[ext_resource type="Texture2D" path="res://assets/animals/tern/arctic_tern_young.svg" id="young_1"]
[ext_resource type="Texture2D" path="res://assets/animals/tern/arctic_tern_baby_flying.png" id="ybaby_flying"]
[ext_resource type="Texture2D" path="res://assets/animals/tern/arctic_tern_baby_sitting.svg" id="ybaby_sitting"]
[ext_resource type="Texture2D" path="res://assets/animals/tern/arctic_tern_young_flying.png" id="yyoung_flying"]
[ext_resource type="Texture2D" path="res://assets/animals/tern/arctic_tern_young_sitting.svg" id="yyoung_sitting"]

[sub_resource type="Resource" id="Moment_0"]
script = ExtResource("pm_script")
id = &"flying"
title = "In flight"
when = PackedStringArray("flying")

[sub_resource type="Resource" id="Moment_1"]
script = ExtResource("pm_script")
id = &"nest"
title = "Sitting on its nest"
when = PackedStringArray("perched")

[sub_resource type="Resource" id="Moment_2"]
script = ExtResource("pm_script")
id = &"visiting"
title = "Visiting another island"
when = PackedStringArray("visiting")

[sub_resource type="Resource" id="Moment_3"]
script = ExtResource("pm_script")
id = &"chick"
title = "A chick"
when = PackedStringArray("baby")

[sub_resource type="Resource" id="Moment_4"]
script = ExtResource("pm_script")
id = &"young"
title = "A young tern"
when = PackedStringArray("juvenile")

[sub_resource type="Resource" id="Moment_5"]
script = ExtResource("pm_script")
id = &"arriving"
title = "Just arrived from the far south"
when = PackedStringArray("event:terns_arriving")
bonus = true

[resource]
script = ExtResource("1_s")
short_name = "Tern"
lays_eggs = true
icon = ExtResource("4_stand")
id = &"arctic_tern"
island = &"arctic_ocean"
display_name = "Arctic Tern"
sprite = ExtResource("2_t")
habitat = "Rocky Arctic shores in summer; the Antarctic in the southern summer"
diet = "Small fish such as Arctic cod, caught by diving from the air"
role = "Nests on the rock in the thaw, and visits your other healthy islands."
fact = "Arctic terns fly from the Arctic to the Antarctic and back every year, the longest migration of any animal: they see two summers a year."
photo_fact = "Over its life an Arctic tern can fly as far as to the Moon and back, more than once."
help_fact = "It needs quiet rock to nest on in the thaw (a Tern Nesting Area) and cod to feed its chicks."
habitat_terrain = PackedStringArray("rock", "ice", "water", "")
swim_speed = 70.0
shy_distance = 70.0
discover_distance = 150.0
curious = false
flies = true
nests_on_ground = true
resting_sprite = ExtResource("4_stand")
floating_sprite = ExtResource("5_float")
perched_sprite = ExtResource("3_sit")
fly_seconds = Vector2(10, 20)
perch_seconds = Vector2(15, 30)
lives_at = &"tern_nesting_area"
adult_home_radius = 140.0
moments = Array[ExtResource("pm_script")]([SubResource("Moment_0"), SubResource("Moment_1"), SubResource("Moment_2"), SubResource("Moment_3"), SubResource("Moment_4"), SubResource("Moment_5")])
grow_days = 2.0
young_sprites = Array[Texture2D]([ExtResource("young_0"), ExtResource("young_1")])
young_flying_sprites = Array[Texture2D]([ExtResource("ybaby_flying"), ExtResource("yyoung_flying")])
young_sitting_sprites = Array[Texture2D]([ExtResource("ybaby_sitting"), ExtResource("yyoung_sitting")])
