[resource]
script = ExtResource("1_2asjv")
id = &"arctic_ocean"
display_name = "Polar Ocean"
description = "Floes of ice and bare rock in cold water. The ice comes and goes with the seasons: what works in the freeze is wrong in the thaw. No trees grow here: bring wood with you."
order = 6
direction = &"colder"
theme = "Global connectivity"
center = Vector2(25600, 0)
waters_radius = 931.0
arrival = Vector2(25136, 16)
boat_mooring = Vector2(25104, 16)
map_icon = ExtResource("1_pu2hy")
requires = &"cargo_module"
health = Array[ExtResource("3_health")]([SubResource("Health_clean"), SubResource("Health_corridor"), SubResource("Health_seals"), SubResource("Health_bears"), SubResource("Health_cod"), SubResource("Health_terns"), SubResource("Health_planning")])
objective = "Live with the seasons, and drill an ice core"
goals = Array[ExtResource("4_goal")]([SubResource("Goal_balanced"), SubResource("Goal_core")])
discovery = &"ice_core"
