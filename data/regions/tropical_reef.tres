[sub_resource type="Resource" id="Goal_restored"]
script = ExtResource("4_goal")
kind = &"flag"
target = &"reef_restored"
text = "Bring the reef back to life (island health 70 %)"
hint = "Build a Coral Restoration Site to grow coral fragments, then plant them on the reef patches from your boat. Keep the lagoon clean, and give parrotfish and clams a home."

[sub_resource type="Resource" id="Goal_rubble"]
script = ExtResource("4_goal")
kind = &"count"
target = &"reef_limestone"
amount = 5
text = "Collect dead coral rubble: each morning up to 2 pieces lie on the sea floor by the reef (pick them up by boat, then sleep for the next)"
hint = "Rubble lies by the reef each morning: pick it up from your boat."

[resource]
script = ExtResource("1_opv3m")
id = &"tropical_reef"
display_name = "Tropical Reef"
description = "A broken ring of islands round a huge shallow lagoon, its coral reef broken and bare. Its animals each do a job: can you get the reef working again?"
order = 4
direction = &"warmer"
theme = "Ecosystem complexity and restoration"
center = Vector2(20480, 0)
waters_radius = 1062.0
arrival = Vector2(19920, 16)
boat_mooring = Vector2(19888, 16)
map_icon = ExtResource("1_cueq0")
requires = &"mangrove_resin"
discovery = &"reef_limestone"
health = Array[ExtResource("3_health")]([SubResource("Health_clean"), SubResource("Health_coral"), SubResource("Health_fish"), SubResource("Health_clams"), SubResource("Health_seahorses"), SubResource("Health_sharks")])
objective = "Bring the coral reef back to life"
goals = Array[ExtResource("4_goal")]([SubResource("Goal_restored"), SubResource("Goal_rubble")])
flagship = &"parrotfish"
flagship_goal = "Bring the parrotfish back to the reef"
flagship_tip = "Parrotfish follow healthy coral: plant coral fragments (from Coral Restoration Sites) on the reef patches from your boat, and keep the water clear of litter."
