[resource]
script = ExtResource("1_t5gy4")
id = &"home_island"
display_name = "Starting Island"
description = "Your horseshoe island and its lagoon, where it all began."
order = 1
theme = "Human impact"
arrival = Vector2(0, 40)
boat_mooring = Vector2(16, 112)
map_icon = ExtResource("1_ovoyb")
discovery = &"salvaged_sonar_core"
objective = "Find and clear the old wreck off the coast"
goals = Array[ExtResource("2_goal")]([SubResource("Goal_found"), SubResource("Goal_cleared"), SubResource("Goal_recovered")])
discovery_text = "Cleaned and working again, the old sonar unit is the Salvaged Sonar Core! Build an Exploration Ship here and install it to find new islands."
health = Array[ExtResource("3_health")]([SubResource("Health_clean"), SubResource("Health_oil"), SubResource("Health_turtles"), SubResource("Health_seabirds"), SubResource("Health_turtle_freed"), SubResource("Health_dolphin_freed"), SubResource("Health_crab_freed")])
arrivals = Array[ExtResource("4_arr")]([SubResource("Arrival_Crab2"), SubResource("Arrival_Dolphin1"), SubResource("Arrival_Dolphin3"), SubResource("Arrival_Crab3"), SubResource("Arrival_Dolphin4"), SubResource("Arrival_Crab4"), SubResource("Arrival_Dolphin5"), SubResource("Arrival_Seabird1"), SubResource("Arrival_Seabird2"), SubResource("Arrival_Seabird3")])
