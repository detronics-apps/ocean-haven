[resource]
script = ExtResource("1_t5gy4")
id = &"home_island"
display_name = "Starting Island"
description = "Your horseshoe island and its lagoon, where it all began."
order = 1
theme = "Human impact"
arrival = Vector2(0, 40)
boat_mooring = Vector2(16, 112)
map_icon = ExtResource("1_ovoyb")
discovery = &"salvaged_sonar_core"
objective = "Clean up the island and help its wildlife"
goals = Array[ExtResource("2_goal")]([SubResource("Goal_litter"), SubResource("Goal_turtle"), SubResource("Goal_dolphin"), SubResource("Goal_crab")])
discovery_text = "Under the last of the litter you cleaned up, you found an old sonar unit. Cleaned and working again, it's the Salvaged Sonar Core! Build an Exploration Ship here and install it to find new islands."
health = Array[ExtResource("3_health")]([SubResource("Health_clean"), SubResource("Health_oil"), SubResource("Health_turtles"), SubResource("Health_turtle_freed"), SubResource("Health_dolphin_freed"), SubResource("Health_crab_freed")])
