[sub_resource type="Resource" id="Goal_gather"]
script = ExtResource("4_goal")
kind = &"count"
target = &"shed_kelp"
amount = 5
text = "Gather shed kelp: each morning up to 2 pieces float up by the healthiest kelp beds (pick them up, then sleep for the next)"

[resource]
script = ExtResource("1_4kmir")
id = &"kelp_forest"
display_name = "Kelp Forest"
description = "Cool, clear water round a long, thin crescent, and a kelp forest that urchins are eating away. Why are there so many urchins?"
order = 2
direction = &"colder"
theme = "Food-web relationships"
center = Vector2(5120, 0)
waters_radius = 982.0
arrival = Vector2(4528, 16)
boat_mooring = Vector2(4496, 16)
map_icon = ExtResource("1_vyq8o")
requires = &"salvaged_sonar_core"
discovery = &"kelp_fibre"
health = Array[ExtResource("3_health")]([SubResource("Health_clean"), SubResource("Health_kelp"), SubResource("Health_balance"), SubResource("Health_otters"), SubResource("Health_fish"), SubResource("Health_cormorants")])
objective = "Restore the kelp forest's food web"
goals = Array[ExtResource("4_goal")]([SubResource("Goal_balance"), SubResource("Goal_gather")])
discovery_text = "Woven from the kelp you gathered, the Kelp Fibre is strong and light. Build an Exploration Ship here and install it: Deep-Water Equipment for rougher, deeper seas."
