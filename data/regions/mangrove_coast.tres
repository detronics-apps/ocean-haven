[sub_resource type="Resource" id="Goal_flowing"]
script = ExtResource("4_goal")
kind = &"flag"
target = &"mangrove_flowing"
text = "Get the water flowing: link 4 nursery pools to the sea (island health 70 %)"
hint = "Use the shovel (Make menu) to dig channels through the mud from the sea to the inland pools. The Waterworks Station's water flow survey shows which pools are cut off."

[sub_resource type="Resource" id="Goal_resin"]
script = ExtResource("4_goal")
kind = &"count"
target = &"mangrove_resin"
amount = 5
text = "Gather resin: each morning up to 2 fallen branches lie by full-grown mangroves (pick them up, then sleep for the next)"
hint = "Fallen branches lie by full-grown mangroves each morning."

[resource]
script = ExtResource("1_kvp4x")
id = &"mangrove_coast"
display_name = "Mangrove Coast"
description = "A maze of grassy fingers and muddy channels. Silt has cut the mangrove pools off from the sea: can you get the water flowing again?"
order = 3
direction = &"warmer"
theme = "The land and ocean connection"
center = Vector2(10240, 0)
waters_radius = 1035.0
arrival = Vector2(9712, 80)
boat_mooring = Vector2(9680, 80)
map_icon = ExtResource("1_xdssp")
requires = &"salvaged_sonar_core"
discovery = &"mangrove_resin"
health = Array[ExtResource("3_health")]([SubResource("Health_clean"), SubResource("Health_water"), SubResource("Health_mangroves"), SubResource("Health_fish"), SubResource("Health_nests"), SubResource("Health_crabs"), SubResource("Health_crocodiles")])
objective = "Get the water flowing through the mangroves again"
goals = Array[ExtResource("4_goal")]([SubResource("Goal_flowing"), SubResource("Goal_resin")])
