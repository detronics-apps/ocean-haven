id = &"mangrove_flamingo"
region = &"mangrove_coast"
species = ExtResource("2_t")
building = &"waterworks_station"
person = &"rosa"
offer_when = PackedStringArray("built:waterworks_station", "here")
found_note = "Rosa: \"The water rose over a flamingo nest and the egg was knocked off the mound: it's cracked, and the parents had to leave it. I've wrapped it in a warm towel: come to the waterworks station, quick!\""
intro = "Rosa: \"The chick inside is nearly ready to hatch. It isn't a pet: once it's grown a little we'll help it join its flock. Will you give it a name?\""
days = 6
tank = false
from_egg = true
egg_damaged = true
egg_colour = Color(0.98, 0.97, 0.93, 1)
mouth = Vector2(0.5, 0.42)
wound_at = Vector2(0.42, 0.85)
eyes = PackedVector2Array(0.44, 0.23, 0.56, 0.23)
food_kind = &"milk"
sprinkle = false
comfort_kind = &"stroke"
comfort_tool = &"duster"
vet_picture = ExtResource("3_v")
day_texts = PackedStringArray("{name} has just hatched: a damp grey fluffball, peeping on the table.", "{name} wobbles about on long legs.", "{name}'s beak is starting to curve.", "{name} dips its beak in a bowl of water, upside down.", "A few pink feathers! {name} is growing up.", "Strong legs, a curved beak: ready for the flock.")
wounds = 1
feed_label = "Feed: crop-milk formula"
feed_result = "{name} gulps it down. Flamingo parents feed their chicks a milk they make in their throat."
comfort_label = "A soft feather duster to snuggle"
comfort_result = "{name} snuggles against the feathers, like under a parent. Rescue centres really do this."
patch_label = "Bandage the scraped leg"
patch_result = "You clean the scrape on {name}'s leg and wrap it. Flamingos need strong legs."
medicine_label = "Vitamins from the vet"
medicine_result = "Vitamins help {name}'s bones grow strong."
ready_text = "Rosa: \"{name} has had six days of care. Shall we let it go to the flock on the flats?\""
release_text = "You walk {name} to the flats. The flock calls, and {name} hurries to join them, a bright band on one leg."
fact = "Flamingos are ringed with coloured leg bands, so people can recognise each bird from far away with binoculars."
visits = PackedStringArray("tropical_reef")
