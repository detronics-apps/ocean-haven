id = &"kelp_otter"
region = &"kelp_forest"
species = ExtResource("2_t")
building = &"kelp_research_platform"
person = &"finn"
offer_when = PackedStringArray("built:kelp_research_platform", "here")
found_note = "Finn: \"A sea otter pup washed up on the beach on its own, crying for its mother. It can't look after itself yet. Come to the platform!\""
intro = "Finn: \"This little otter got separated from its mother in a storm. It isn't a pet: we're helping it get home. Will you give it a name?\""
days = 6
tank = false
from_egg = false
egg_colour = Color(1, 1, 1, 1)
mouth = Vector2(0.5, 0.47)
wound_at = Vector2(0.34, 0.9)
eyes = PackedVector2Array(0.41, 0.34, 0.59, 0.34)
food_kind = &"clam"
sprinkle = false
comfort_kind = &"stroke"
comfort_tool = &"brush"
vet_picture = ExtResource("3_v")
day_texts = PackedStringArray("{name} is small and cold, curled up on the table.", "{name} squeaks when it hears you.", "{name} rolls on its back and grooms its tummy.", "{name} is hungry all the time now.", "{name} cracks a shell on its chest with a stone.", "Warm, strong and wild again.")
wounds = 1
feed_label = "Feed: clams and crab"
feed_result = "Crunch! Sea otters eat about a quarter of their own weight in food every day."
comfort_label = "Groom its fur clean and fluffy"
comfort_result = "{name}'s fur fluffs up again. Otters have no blubber: clean fur full of air keeps them warm."
patch_label = "Clean the scrape on its paw"
patch_result = "You clean a scrape from the rocks and cover it. {name} sniffs the bandage."
medicine_label = "Medicine from the vet"
medicine_result = "A quick shot from the vet, and {name} is breathing easier."
ready_text = "Finn: \"{name} has had six days of care. Shall we take it to the kelp?\""
release_text = "You carry {name} to the edge of the kelp. {name} floats on its back for a moment, looks at you... and dives, a bright tag on its back foot."
fact = "Aquariums raise stranded sea otter pups, sometimes with adult otters as foster mothers, and release them into the wild."
