[gd_resource type="Resource" script_class="RescueData" format=3]

[ext_resource type="Script" path="res://scripts/systems/rescue_data.gd" id="1_r"]
[ext_resource type="Resource" path="res://data/animals/green_turtle.tres" id="2_t"]
[ext_resource type="Texture2D" path="res://assets/animals/vet/home_turtle.svg" id="3_v"]

[resource]
script = ExtResource("1_r")
id = &"home_turtle"
region = &"home_island"
species = ExtResource("2_t")
building = &"marine_rescue_station"
person = &"maya"
offer_when = PackedStringArray("built:marine_rescue_station", "here")
found_note = "Maya: \"A young turtle was found tangled in fishing line, and it's very weak. It needs care before it can go back to sea. Come to the rescue station!\""
intro = "Maya: \"This young green turtle was caught in old fishing line. It's weak, but with care it will get better. It isn't a pet: we're helping it get home. Would you give it a name?\""
days = 6
vet_picture = ExtResource("3_v")
day_texts = PackedStringArray("Weak and tired from the fishing line. {name} lies very still on the table.", "{name} lifts its head when you come in.", "{name} paddles its flippers on the table: it wants to swim.", "{name} ate everything this morning.", "{name} swam laps of the big pool all morning.", "Strong and alert. Almost ready for the sea.")
wounds = 2
feed_label = "Feed: seagrass and greens"
feed_result = "{name} munches the seagrass. Green turtles eat more and more seagrass and algae as they grow."
comfort_label = "Keep it calm: a quiet, dim pool"
comfort_result = "{name} rests. Wild animals heal best somewhere calm and quiet, with as little handling as possible."
patch_label = "Clean and patch a line cut"
patch_result = "You clean a cut the fishing line made on {name}'s flipper and cover it. It will heal."
medicine_label = "Vitamin shot from the vet"
medicine_result = "A quick shot from the vet. Vitamins help a weak turtle get its strength back."
ready_text = "Maya: \"{name} has had six days of care. Shall we take it down to the sea?\""
release_text = "You carry {name} down to the water. A moment's pause... and {name} swims off into the waves, the bright tag on its flipper flashing."
fact = "Sea turtle rescue centres care for turtles hurt by fishing gear, boats and plastic, and tag them before they go back to sea, so they can be recognised if they are seen again."
visits = PackedStringArray("mangrove_coast", "tropical_reef")
