id = &"home_turtle"
region = &"home_island"
species = ExtResource("2_t")
building = &"marine_rescue_station"
person = &"maya"
offer_when = PackedStringArray("built:marine_rescue_station", "here")
found_note = "Maya: \"The waves washed one turtle egg out of its nest and knocked it about: the shell is cracked. The little one inside needs help to make it. Bring it to the rescue station!\""
intro = "Maya: \"The little turtle inside is almost ready to come out. It isn't a pet: we're helping the hatchling get to the sea. Would you give it a name?\""
days = 6
tank = false
from_egg = true
egg_damaged = true
egg_colour = Color(0.96, 0.94, 0.88, 1)
mouth = Vector2(0.5, 0.37)
wound_at = Vector2(0.8, 0.53)
eyes = PackedVector2Array(0.42, 0.25, 0.58, 0.25)
food_kind = &"shrimp"
sprinkle = false
comfort_kind = &"place"
comfort_tool = &"cloth"
vet_picture = ExtResource("3_v")
day_texts = PackedStringArray("{name} has just hatched: tiny, with a soft shell and a bit of yolk still under its belly.", "{name} waves its flippers as if it's already swimming.", "{name} paddles laps of the shallow tub.", "{name} snapped up every shrimp this morning.", "{name}'s shell is getting harder, and it's grown!", "Bigger and strong: ready for the sea.")
wounds = 1
feed_label = "Feed: tiny shrimp"
feed_result = "{name} snaps up the shrimp. Young green turtles eat small sea animals; only grown-ups live on seagrass."
comfort_label = "A soft cloth over its tub: quiet and dim"
comfort_result = "{name} rests. Wild animals heal best somewhere calm and quiet, with as little handling as possible."
patch_label = "Clean the scratch on its flipper"
patch_result = "You clean a little scratch on {name}'s flipper from the rough sand, and cover it. It will heal."
medicine_label = "Vitamins from the vet"
medicine_result = "A drop of vitamins from the vet helps {name}'s shell grow strong."
ready_text = "Maya: \"{name} has had six days of care. Shall we take it down to the sea?\""
release_text = "You carry {name} down to the water. A moment's pause... and {name} swims off into the waves, the bright tag on its flipper flashing."
fact = "Sea turtle rescue centres care for turtles hurt by fishing gear, boats and plastic, and tag them before they go back to sea, so they can be recognised if they are seen again."
visits = PackedStringArray("mangrove_coast", "tropical_reef")
