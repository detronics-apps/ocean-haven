[ext_resource type="Texture2D" path="res://assets/animals/vet/polar_seal.svg" id="3_v"]

[resource]
script = ExtResource("1_r")
id = &"polar_seal"
region = &"arctic_ocean"
species = ExtResource("2_t")
building = &"polar_research_station"
person = &"sanna"
offer_when = PackedStringArray("built:polar_research_station", "here")
found_note = "Sanna: \"We found a tiny ringed seal pup on the ice, all wrapped up in an old plastic sheet and net, far from its mother's den. Come to the station, quick!\""
intro = "Sanna: \"We cut the litter off it. It's tiny, cold and hungry. It isn't a pet: we're helping it home to the ice. Will you give it a name?\""
days = 6
tank = false
from_egg = false
egg_colour = Color(1, 1, 1, 1)
mouth = Vector2(0.5, 0.53)
wound_at = Vector2(0.17, 0.84)
eyes = PackedVector2Array(0.39, 0.37, 0.61, 0.37)
food_kind = &"fish"
sprinkle = false
comfort_kind = &"place"
comfort_tool = &"ice"
vet_picture = ExtResource("3_v")
day_texts = PackedStringArray("{name} is a fluffy white pup, shivering on the table.", "{name} watches you with big dark eyes.", "{name} wriggles across the table towards the water bowl.", "{name} is growing a sleek grey coat.", "{name} dives in the cold pool and stays under a long time.", "Sleek, strong and shy of people: ready.")
wounds = 1
feed_label = "Feed: fish formula, then small fish"
feed_result = "{name} slurps it up. In the wild a pup drinks rich milk, then learns to catch Arctic cod."
comfort_label = "A cool, quiet pen with ice"
comfort_result = "{name} rests on the ice. Ringed seal pups are born in snow dens on the sea ice."
patch_label = "Clean the rub the net made on its flipper"
patch_result = "You clean the sore spot where the net rubbed {name}'s flipper, and cover it. It will heal."
medicine_label = "Medicine for its cough"
medicine_result = "A shot from the vet, and {name}'s breathing is easier."
ready_text = "Sanna: \"{name} has had six days of care. Shall we take it to the edge of the old ice?\""
release_text = "You set {name} down on the old ice. It sniffs the air, slides to the edge... and slips into the water, a bright tag on its flipper."
fact = "Seal rescue centres tag the pups they release on a flipper, so they can be recognised if they haul out on a beach again."
