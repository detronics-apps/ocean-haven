story_intro = "Sanna: \"Help me plan the drill site on the station's ice map. Swap pieces to make rows of three: every block of old ice you clear shows us thick, old ice that will last three days.\""
story_done = "Sanna: \"That's it. I've marked the oldest, thickest ice on your map: build the Ice Core Drill Site there.\""
practice_intro = "Ice Match for fun: each level has a bigger map and more kinds of piece. Can you beat your best time?"
