[ext_resource type="Resource" path="res://data/missions/cargo_search.tres" id="2_m"]

[resource]
script = ExtResource("1_a")
id = &"echo_dive"
display_name = "Echo Dive"
verb = "Echo Dive"
building = &"deep_ocean_outpost"
person = &"imani"
unlock_any = PackedStringArray("asked:cargo", "flag:cargo_located")
story_intro = "Imani: \"Take the controls! Hold your finger where you want the sub to go: down to dive, up to rise. The cargo module is lying at about 1,000 metres. Below the sunlight only the lamp and the sonar's ping show the way, so watch for who lives down there, and grab any lost gear you pass.\""
story_done = "Imani: \"There it is, the lost cargo module! I've floated it up on lifting bags. Sail out and tow it in.\""
practice_intro = "Take the submarine down for fun: each level goes 1,000 m deeper, all the way to 5,000 m, the abyss. Lost gear you pick up takes 1.5 s off your time. Can you beat your best?"
levels = Array[Vector3i]([Vector3i(10, 4, 2), Vector3i(20, 6, 2), Vector3i(30, 8, 3), Vector3i(40, 10, 4), Vector3i(50, 12, 5)])
reward_mission = ExtResource("2_m")
region = &"deep_sea"
