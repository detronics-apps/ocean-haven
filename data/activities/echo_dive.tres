[ext_resource type="Resource" path="res://data/missions/cargo_search.tres" id="2_m"]

[resource]
script = ExtResource("1_a")
id = &"echo_dive"
display_name = "Echo Dive"
verb = "Echo Dive"
building = &"deep_ocean_outpost"
person = &"imani"
unlock_any = PackedStringArray("asked:cargo", "flag:cargo_located")
story_intro = "Imani: \"Take the controls! Hold your finger where you want the sub to go: it keeps sinking, and the lower on the screen it is the faster it goes. Careful: it can take 3 bumps, and wrenches deeper down repair it. The cargo module is lying at about 1,000 metres. Below the sunlight you only see while the sonar light is on, so watch for who lives down there, grab any lost gear and steer round the jellyfish and boulders.\""
story_done = "Imani: \"There it is, the lost cargo module! I've floated it up on lifting bags. Sail out and tow it in.\""
practice_intro = "Take the submarine down for fun: each level goes 1,000 m deeper (down to 5,000 m, the abyss), sinks faster, has more jellyfish and boulders in the way, and the sonar light is on less of the time (90 % at level 1, 50 % at level 5). The lower on the screen, the faster you sink. Every bump costs one of your 3 hearts (wrenches deeper down repair one); until you reach the sea floor your record is how deep you got, after that it's your time. Lost gear takes 1.5 s off. Can you beat your best?"
levels = Array[Vector3i]([Vector3i(10, 3, 1), Vector3i(20, 7, 2), Vector3i(30, 12, 3), Vector3i(40, 18, 4), Vector3i(50, 25, 5)])
reward_mission = ExtResource("2_m")
region = &"deep_sea"
