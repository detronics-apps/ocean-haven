[resource]
script = ExtResource("1_a")
id = &"echo_dive"
display_name = "Echo Dive"
verb = "Echo Dive"
building = &"deep_ocean_outpost"
person = &"imani"
unlock_any = PackedStringArray("asked:cargo", "flag:cargo_located")
story_intro = "Imani: \"Take the controls! We go straight down from the surface. Steer round the rock ledges: the cargo module is lying at about 1,000 metres. Watch for who lives down there on the way.\""
story_done = "Imani: \"There it is, the lost cargo module! I've floated it up on lifting bags. Sail out and tow it in.\""
practice_intro = "Take the submarine down for fun: each level goes deeper and sinks faster, all the way to 2,500 m. Can you beat your best time?"
levels = Array[Vector3i]([Vector3i(10, 2, 2), Vector3i(13, 2, 2), Vector3i(16, 3, 3), Vector3i(20, 3, 4), Vector3i(25, 4, 5)])
