[resource]
script = ExtResource("1_a")
id = &"channel_flow"
display_name = "Channel Flow"
verb = "Channel Flow"
building = &"waterworks_station"
person = &"rosa"
unlock_any = PackedStringArray("asked:flowing", "flag:mangrove_flowing")
story_intro = "Rosa: \"Here's the station's map of the channels. Turn the channels so sea water can reach every pool, and we'll see which ones are cut off out there.\""
story_done = "Rosa: \"So that's how the water should run! The station has marked which pools are cut off: dig those channels with your shovel.\""
practice_intro = "Link the pools to the sea for fun: each level is a bigger channel map. Can you beat your best time?"
levels = Array[Vector3i]([Vector3i(5, 4, 2), Vector3i(6, 5, 3), Vector3i(7, 5, 4), Vector3i(8, 6, 5), Vector3i(9, 6, 6)])
