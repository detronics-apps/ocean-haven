[resource]
script = ExtResource("1_a")
id = &"otter_dive"
display_name = "Otter Dive"
verb = "Otter Dive"
person = &"finn"
unlock_any = PackedStringArray("asked:balance", "flag:kelp_balanced")
story_intro = "Finn: \"I've got ten minutes before I head back up. Want to help me count the urchins? Dive like a sea otter: hold to go down, let go to float up. Mind your air, and keep clear of the litter drifting about: it catches you!\""
story_done = "Finn: \"Look at all those urchins! Sea otters crack them open on their bellies with a stone. I'll mark the worst beds on your map.\""
practice_intro = "Dive from the old jetty for fun: collect the level's urchins as fast as you can (10, then 20, 30, 40 and 50). Sea otters must come up to breathe: stay under with no air left and you lose a heart, and litter catches you too. Each level has a little less air, more kelp, a stronger current and more litter. Collect them all to set a time and open the next level."
levels = Array[Vector3i]([Vector3i(10, 2, 1), Vector3i(20, 3, 2), Vector3i(30, 4, 3), Vector3i(40, 5, 4), Vector3i(50, 6, 5)])
reward_mission = ExtResource("2_m")
spot = Vector2(4560, -40)
region = &"kelp_forest"
place = ExtResource("3_j")
place_offset = Vector2(-72, -12)
place_name = "old jetty"
closed_note = "An old jetty, its planks worn smooth by years of divers. Finn might know what it's for."
