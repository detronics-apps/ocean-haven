[gd_resource type="Resource" script_class="EventData" format=3]

[ext_resource type="Script" path="res://scripts/systems/event_data.gd" id="1_s"]

[resource]
script = ExtResource("1_s")
id = &"flash_flood"
display_name = "Flash Flood"
region = &"mangrove_coast"
min_gap_days = 30
max_gap_days = 60
warning_days = 3
warning_days_max = 4
warning = "Heavy rain is coming to the Mangrove Coast {when}! Floodwater will dump silt in the channels. Open your gates so it can flush through, and secure your buildings there."
banner = "Flash flood {when} on the Mangrove Coast"
aftermath = "The flood has passed. %d building(s) need repairing and silt has blocked channels. A water flow survey shows which pools are cut off: dig them out again."
damage_chance = 0.3
litter_washed = 8
repair_wood = 1
flood_silt = 0.7
weather = &"flood"
