[gd_resource type="Resource" script_class="EventData" format=3]

[ext_resource type="Script" path="res://scripts/systems/event_data.gd" id="1_evt"]

[resource]
script = ExtResource("1_evt")
id = &"ice_breakup"
display_name = "Major Ice Breakup"
region = &"arctic_ocean"
min_gap_days = 30
max_gap_days = 60
warning_days = 3
warning_days_max = 4
warning = "Major ice movement detected at the Polar Ocean: a big piece of ice will break away {when}! Keep your pupping zones and drill site on the biggest floes' old ice."
banner = "Ice breakup {when} at the Polar Ocean"
aftermath = "A big piece of ice has broken away! A breakup survey from the Polar Research Station shows what went into the water: move it to solid ice. The ice will freeze back over in the next cold spell."
damage_chance = 0.0
litter_washed = 4
repair_wood = 1
ice_breakup = 0.35
weather = &"swell"
