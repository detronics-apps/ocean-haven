[gd_resource type="Resource" script_class="EventData" format=3]

[ext_resource type="Script" path="res://scripts/systems/event_data.gd" id="1_evt"]

[resource]
script = ExtResource("1_evt")
id = &"coastal_storm"
display_name = "Coastal Storm"
region = &"home_island"
min_gap_days = 30
max_gap_days = 60
warning_days = 2
warning_days_max = 2
warning = "A storm is coming to the Starting Island {when}! Secure your buildings and protection areas, and clear litter off the beaches."
banner = "Storm {when} on the Starting Island: secure your buildings there"
aftermath = "The storm has passed. %d building(s) need repairing, and litter has washed up on the beaches."
damage_chance = 0.6
litter_washed = 20
litter_washed_max = 35
litter_floating = 8
repair_wood = 1
injures = PackedStringArray("green_turtle", "red_footed_booby")
injured_max = 3
weather = &"storm"
