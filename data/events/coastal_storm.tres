[gd_resource type="Resource" script_class="EventData" format=3]

[ext_resource type="Script" path="res://scripts/systems/event_data.gd" id="1_evt"]

[resource]
script = ExtResource("1_evt")
id = &"coastal_storm"
display_name = "Coastal Storm"
region = &"home_island"
min_gap_days = 30
chance_per_day = 0.02
warning_days = 1
warning = "Storm coming tomorrow! Secure your buildings and protection areas, and clear litter off the beaches."
banner = "Storm tomorrow: secure your buildings"
aftermath = "The storm has passed. %d building(s) need repairing, and litter has washed up on the beaches."
damage_chance = 0.6
litter_washed = 10
repair_wood = 1
injures = PackedStringArray("green_turtle", "red_footed_booby")
injured_max = 3
