[resource]
script = ExtResource("1_plant")
id = &"giant_kelp"
display_name = "Giant Kelp"
picture = ExtResource("2_plant")
habitat = "Cool, clear, shallow seas over rocky floors (the Kelp Forest)"
fact = "Giant kelp is one of the fastest-growing living things on Earth: it can grow about half a metre in a single day. It's a seaweed, not a plant with roots, holding on to rocks with a 'holdfast'."
role = "The forest itself: shelter for rockfish, food for urchins, and a resting place for otters."
