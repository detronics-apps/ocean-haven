[resource]
script = ExtResource("1_plant")
id = &"polar_willow"
display_name = "Polar Willow"
picture = ExtResource("2_plant")
habitat = "Arctic rock and tundra (the Polar Ocean)"
fact = "The polar willow is a tree only a few centimetres tall. It grows flat to the ground, hides under the snow in winter, and its fluffy seeds blow far on the wind."
role = "Blown in by a storm's wind; too small to cut, it just grows."
