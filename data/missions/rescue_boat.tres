[gd_resource type="Resource" script_class="MissionData" format=3]

[ext_resource type="Script" path="res://scripts/systems/mission_data.gd" id="1_mis"]

[resource]
script = ExtResource("1_mis")
id = &"rescue_boat"
display_name = "Rescue boat patrol"
description = "The rescue boat searches the island's waters and beaches for animals in distress, like one tangled in fishing line."
order = 1
facility = &"marine_rescue_station"
cost = 20
hours = 2.0
finds_group = &"animals"
finds_species = &""
finds_tangled = true
marker_colour = Color(1, 0.4196, 0.2902, 1)
report = "The rescue boat found %d animal(s) that need your help! They're marked in red on your minimap."
report_none = "The rescue boat found no animals in distress. Everyone is safe and well!"
