[gd_resource type="Resource" script_class="MissionData" format=3]

[ext_resource type="Script" path="res://scripts/systems/mission_data.gd" id="1_mis"]
[ext_resource type="Texture2D" path="res://assets/ui/missions/ice_survey.svg" id="2_icon"]

[resource]
script = ExtResource("1_mis")
id = &"ice_survey"
display_name = "Ice survey"
icon = ExtResource("2_icon")
description = "Marks which ice is old and thick (it lasts all year; from then on it shows a little bluer than seasonal ice) and which is seasonal, and where the season is heading. Pupping zones on seasonal ice are marked: move them to old ice."
order = 1
facility = &"polar_research_station"
cost = 15
minutes = 2.0
effect = &"ice_survey"
effect_days = 0.0
marker_colour = Color(0.7, 0.9, 1, 1)
report = "{detail}"
report_none = "{detail}"
