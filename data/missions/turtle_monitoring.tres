[gd_resource type="Resource" script_class="MissionData" format=3]

[ext_resource type="Script" path="res://scripts/systems/mission_data.gd" id="1_mis"]

[resource]
script = ExtResource("1_mis")
id = &"turtle_monitoring"
display_name = "Turtle monitoring"
description = "Researchers find the active turtle nests and protect them for 2 days, so a storm can't wash them away. Best sent when a storm is coming."
order = 4
facility = &"marine_rescue_station"
cost = 10
minutes = 3.0
finds_group = &"nests"
finds_species = &"green_turtle"
finds_tangled = false
marker_colour = Color(0.3725, 0.8627, 0.4784, 1)
report = "Turtle monitoring found and protected %d nest(s) for the next 2 days. They're marked in green on your minimap."
report_none = "Turtle monitoring found no active nests right now."
effect = &"turtle_monitoring"
effect_days = 2.0
