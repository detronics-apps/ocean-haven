[resource]
script = ExtResource("1_mis")
id = &"trace_bags"
display_name = "Trace the bags"
icon = ExtResource("2_icon")
description = "Follows the water back up the channels: where do the plastic bags come from?"
order = 9
facility = &"waterworks_station"
cost = 20
minutes = 2.0
marker_colour = Color(0.9, 0.9, 0.9, 1)
report = "The bags come from the fish market up the coast: every fish goes home in a new plastic bag, used once. Talk to Rosa."
report_none = "The bags come from the fish market up the coast: every fish goes home in a new plastic bag, used once. Talk to Rosa."
effect = &"investigate"
show_flag = &"bags_asked"
hide_flag = &"bags_traced"
marks_flag = &"bags_traced"
