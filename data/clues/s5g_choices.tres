[resource]
script = ExtResource("1_clue")
id = &"s5g_choices"
node = 5
order = 1
question = "Does what I do change what happens?"
activate = PackedStringArray("memo:area_busy", "memo:patrol_hurt", "memo:caught_by_litter", "memo:bird_left", "clue:s2k_kelp", "clue:s2m_pools")
evidence = PackedStringArray("g_area | built:turtle_protection_area & nested:green_turtle>=1 | When I made a quiet turtle area, a turtle nested there.", "g_channel | pools_linked:1 & animals:juvenile_snapper>=4@mangrove_coast | When I opened the water to a nursery pool, young fish came to live there.", "g_coral | reef_regrown | When I planted coral, it grew back.", "b_litter | memo:caught_by_litter | When I left litter lying near an animal, it got caught in it.", "b_trees | memo:bird_left | When there were too few trees left, a bird that nests in them flew off.", "b_help | memo:area_busy | When I built right beside the turtle area, no turtle would nest there.", "b_boats | memo:patrol_hurt | When my patrol boats crowded the water, a boat-shy animal was hurt.", "g_secured | memo:storm_prepared | When I secured my buildings before a storm, they came through.", "b_unsecured | memo:storm_prepared | When I didn't secure a building before a storm, it was damaged.")
answer = PackedStringArray("1: g_area, g_channel, g_coral, g_secured", "1: b_litter, b_trees, b_help, b_boats, b_unsecured")
statements = PackedStringArray("{g0.1} {g1.1} What I do changes what happens.")
guarantee = &"L"
section = &"people"
title = "Do my choices matter?"
short = "Yes, both ways"
evidence_pictures = {
"g_area": ExtResource("10_ev"),
"g_channel": ExtResource("11_ev"),
"g_coral": ExtResource("12_ev"),
"b_litter": ExtResource("13_ev"),
"b_trees": ExtResource("14_ev"),
"b_help": ExtResource("15_ev")
}
links = PackedStringArray("trash", "plants", "animals", "storms")
