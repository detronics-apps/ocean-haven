question = "How did plastic get into the polar ice?"
activate = PackedStringArray("flag:fibres_asked")
evidence = PackedStringArray("report | flag:fibres_traced | Under the microscope, the threads in the ice were plastic, from clothes in the wash.", "filter | stopped:microfibres | Kai's filters went into the washing machines.")
