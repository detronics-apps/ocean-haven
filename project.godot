; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="BlueHaven"
run/main_scene="res://scenes/world/ocean_world.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/ui/app_icon_512.png"

[autoload]

Inventory="*res://scripts/systems/inventory.gd"
Journal="*res://scripts/systems/journal.gd"
SaveGame="*res://scripts/systems/save_system.gd"
GameClock="*res://scripts/systems/time_system.gd"
RangerProfile="*res://scripts/systems/ranger_profile.gd"
Funding="*res://scripts/systems/money_system.gd"
Fleet="*res://scripts/systems/fleet.gd"
Missions="*res://scripts/systems/missions.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor]

export/convert_text_resources_to_binary=false

